function t(key) {
  return (translations[currentLang] && translations[currentLang][key]) || (translations['fr'][key]) || key;
}

function applyLang() {
  // 1. Traduire tous les éléments avec data-i18n
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    var key = el.getAttribute('data-i18n');
    var val = t(key);
    if (val && val !== key) el.textContent = val;
  });

  // 2. Nav labels (tous les onglets)
  var navMap = {
    dressing:'tab_dressing', avatar:'tab_avatar',
    community:'tab_community', history:'tab_history', settings:'tab_settings'
  };
  Object.keys(navMap).forEach(function(tab) {
    var nav = document.getElementById('nav' + tab.charAt(0).toUpperCase() + tab.slice(1));
    if (nav) { var label = nav.querySelector('.nav-label'); if (label) label.textContent = t(navMap[tab]); }
  });

  // 3. Titre du header selon l'onglet actif
  var activeNav = document.querySelector('.nav-item.active');
  if (activeNav) {
    var activeTab = activeNav.id.replace('nav','').toLowerCase();
    var titles2 = {
      dressing:t('tab_dressing'), avatar:t('tab_avatar'),
      community:t('tab_community'), history:t('tab_history'), settings:t('tab_settings')
    };
    var titleEl = document.getElementById('currentTabTitle');
    if (titleEl && titles2[activeTab]) titleEl.textContent = titles2[activeTab];
  }

  // 4. Label langue courante
  var langLabels = {fr:'Français 🇫🇷', en:'English 🇬🇧', es:'Español 🇪🇸'};
  var lbl = document.getElementById('currentLangLabel');
  if (lbl) lbl.textContent = langLabels[currentLang] || 'Français 🇫🇷';

  // 5. Activer la bonne langue dans le modal
  ['fr','en','es'].forEach(function(l) {
    var el = document.getElementById('lang-' + l);
    if (el) el.classList.toggle('active', l === currentLang);
  });

  // 6. Sections settings
  document.querySelectorAll('.settings-group-title').forEach(function(el) {
    var txt = el.textContent.trim().toUpperCase();
    var map = {
      'CONTENU':t('section_content'), 'CONTENT':t('section_content'),
      'CONTENIDO':t('section_content'),
      'COMPTE':t('section_account'), 'ACCOUNT':t('section_account'),
      'CUENTA':t('section_account'),
      'APPARENCE':t('section_appear'), 'APPEARANCE':t('section_appear'),
      'APARIENCIA':t('section_appear')
    };
    if (map[txt]) el.textContent = map[txt];
  });

  // 7. Bouton partager communauté
  var shareBtn = document.getElementById('shareOutfitBtn');
  if (shareBtn) shareBtn.childNodes[shareBtn.childNodes.length-1].textContent = ' ' + t('share_outfit');

  // 8. Bouton déconnexion
  var logoutBtn = document.querySelector('.logout-btn');
  if (logoutBtn) logoutBtn.textContent = t('logout');
}

function openLangModal() {
  document.getElementById('langModal').classList.add('open');
}
function closeLangModal(e) {
  if (!e || e.target.id === 'langModal') {
    document.getElementById('langModal').classList.remove('open');
  }
}
function setLang(lang) {
  currentLang = lang;
  localStorage.setItem('dc_lang', lang);
  applyLang();
  closeLangModal();
  var msgs = {fr:'🇫🇷 Français activé',en:'🇬🇧 English enabled',es:'🇪🇸 Español activado'};
  showToast(msgs[lang]);
}

/* ══════════════════════════════════════
   NOTIFICATIONS
══════════════════════════════════════ */
var notifEnabled = localStorage.getItem('dc_notif') === 'true';
function applyNotifState() {
  var toggle = document.getElementById('notifToggle');
  if (toggle) toggle.classList.toggle('on', notifEnabled);
}
async function toggleNotifications() {
  if (!notifEnabled) {
    if ('Notification' in window) {
      var perm = await Notification.requestPermission();
      if (perm === 'granted') {
        notifEnabled = true;
        localStorage.setItem('dc_notif', 'true');
        applyNotifState();
        new Notification('DressCode 👗', {body: 'Notifications activées ! On vous rappellera de choisir votre tenue.', icon: '/favicon.ico'});
        showToast(t('notif_on'));
      } else {
        showToast('Notifications refusées dans les réglages du téléphone');
      }
    } else {
      showToast('Notifications non supportées sur ce navigateur');
    }
  } else {
    notifEnabled = false;
    localStorage.setItem('dc_notif', 'false');
    applyNotifState();
    showToast(t('notif_off'));
  }
}

function sendDailyNotif() {
  if (notifEnabled && Notification.permission === 'granted') {
    new Notification("DressCode ✦", {body: "Quelle tenue allez-vous porter aujourd'hui ?", icon: "/favicon.ico"});
  }
}

/* ── AVATAR BITMOJI / PHOTO ── */
function importAvatar(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    var dataUrl = ev.target.result;
    // Sauvegarder
    localStorage.setItem('dc_avatar_img', dataUrl);
    // Afficher
    showAvatarSaved(dataUrl);
    showToast('✦ Avatar enregistré !');
  };
  reader.readAsDataURL(file);
}

function showAvatarSaved(dataUrl) {
  var placeholder = document.getElementById('avatarPlaceholder');
  var savedDisplay = document.getElementById('avatarSavedDisplay');
  var savedImg = document.getElementById('avatarSavedImg');
  if (placeholder) placeholder.style.display = 'none';
  if (savedImg) savedImg.src = dataUrl;
  if (savedDisplay) savedDisplay.style.display = 'block';
  // Mettre à jour le badge utilisateur dans le header
  var badge = document.getElementById('userAvatarBadge');
  if (badge) {
    badge.style.backgroundImage = 'url(' + dataUrl + ')';
    badge.style.backgroundSize = 'cover';
    badge.style.backgroundPosition = 'center';
    badge.textContent = '';
  }
}

function removeAvatar() {
  localStorage.removeItem('dc_avatar_img');
  var placeholder = document.getElementById('avatarPlaceholder');
  var savedDisplay = document.getElementById('avatarSavedDisplay');
  if (placeholder) placeholder.style.display = 'block';
  if (savedDisplay) savedDisplay.style.display = 'none';
  showToast('Avatar supprimé');
}

function loadSavedAvatar() {
  var saved = localStorage.getItem('dc_avatar_img');
  if (saved) showAvatarSaved(saved);
}

