function openCGU() {
  var modal = document.getElementById('modalCGU');
  var content = document.getElementById('cguContent');
  if (content) content.innerHTML = CGU_CONTENT;
  if (modal) { modal.style.display = 'flex'; modal.scrollTop = 0; }
}

function openPrivacy() {
  var modal = document.getElementById('modalPrivacy');
  var content = document.getElementById('privacyContent');
  if (content) content.innerHTML = PRIVACY_CONTENT;
  if (modal) { modal.style.display = 'flex'; modal.scrollTop = 0; }
}

function closeLegal(type) {
  var modal = document.getElementById('modal' + type);
  if (modal) modal.style.display = 'none';
}

/* ══ TABLEAU DE BORD CRÉATEUR ══ */
function openDashboard() {
  var screen = document.getElementById('dashboardScreen');
  if (screen) { screen.style.display = 'flex'; loadDashboard(); }
}

function closeDashboard() {
  var screen = document.getElementById('dashboardScreen');
  if (screen) screen.style.display = 'none';
}

async function loadDashboard() {
  var spinner = document.getElementById('dashSpinner');
  var refreshText = document.getElementById('dashRefreshText');
  if (spinner) spinner.style.display = 'block';
  if (refreshText) refreshText.textContent = 'Chargement...';

  try {
    if (db) {
      // Charger les posts communauté
      var postsSnap = await db.collection('community_posts').get();
      var posts = [];
      postsSnap.forEach(function(doc) { posts.push(Object.assign({id:doc.id}, doc.data())); });

      var totalPosts = posts.length;
      var totalLikes = posts.reduce(function(acc, p) { return acc + (p.likes ? p.likes.length : 0); }, 0);
      var totalComments = posts.reduce(function(acc, p) { return acc + (p.comments ? p.comments.length : 0); }, 0);

      // Charger les users
      var usersSnap = await db.collection('users').get();
      var users = [];
      usersSnap.forEach(function(doc) { users.push(Object.assign({id:doc.id}, doc.data())); });
      var totalUsers = usersSnap.size;

      // Stats abonnements
      var subsSnap = await db.collection('subscriptions').get();
      var styleSubs = 0, premiumSubs = 0;
      subsSnap.forEach(function(doc) {
        var d = doc.data();
        if (d.plan === 'style') styleSubs++;
        if (d.plan === 'premium') premiumSubs++;
      });

      // Mettre à jour l'UI
      setDashVal('dashTotalUsers', totalUsers);
      setDashVal('dashUsersToday', totalUsers + ' inscrits au total');
      setDashVal('dashTotalPosts', totalPosts);
      setDashVal('dashTotalLikes', totalLikes);
      setDashVal('dashTotalOutfits', '—');
      setDashVal('dashTotalPostsCard', totalPosts);
      setDashVal('dashTotalComments', totalComments);
      setDashVal('dashTotalLikesCard', totalLikes);
      setDashVal('dashStyleSubs', styleSubs);
      setDashVal('dashPremiumSubs', premiumSubs);

      var monthlyRev = (styleSubs * 4.99 + premiumSubs * 9.99).toFixed(2);
      setDashVal('dashMonthlyRevenue', monthlyRev + '€/mois');
      setDashVal('dashRevenue', monthlyRev + '€');

      // Top posts
      var currentMonth = new Date().getMonth() + '-' + new Date().getFullYear();
      var monthPosts = posts.filter(function(p){ return p.month === currentMonth; });
      monthPosts.sort(function(a,b){ return (b.likes?b.likes.length:0) - (a.likes?a.likes.length:0); });

      var topEl = document.getElementById('dashTopPosts');
      if (topEl) {
        if (!monthPosts.length) {
          topEl.innerHTML = '<div style="font-size:13px;color:#888;text-align:center;padding:16px">Aucune tenue ce mois-ci</div>';
        } else {
          topEl.innerHTML = monthPosts.slice(0,5).map(function(p, i) {
            var likes = p.likes ? p.likes.length : 0;
            var medals = ['🥇','🥈','🥉','4️⃣','5️⃣'];
            return '<div class="dash-metric-row">' +
              '<div style="display:flex;align-items:center;gap:8px">' +
                '<span style="font-size:16px">' + medals[i] + '</span>' +
                '<div><div class="dash-metric-label">' + (p.userName||'Utilisateur') + '</div>' +
                '<div style="font-size:11px;color:#888">' + (p.mood||'Smart casual') + '</div></div>' +
              '</div>' +
              '<div style="display:flex;align-items:center;gap:6px">' +
                '<span style="font-size:13px;color:var(--purple-light);font-weight:600">❤ ' + likes + '</span>' +
              '</div>' +
            '</div>';
          }).join('');
        }
      }

      // Tenue du mois winner
      var winnerEl = document.getElementById('dashMonthWinner');
      if (winnerEl) {
        if (monthPosts.length && monthPosts[0].likes && monthPosts[0].likes.length > 0) {
          var winner = monthPosts[0];
          winnerEl.innerHTML = '<div style="display:flex;align-items:center;gap:10px">' +
            '<div style="font-size:32px">🏆</div>' +
            '<div><div style="font-size:14px;font-weight:600;color:#0A0A0A">' + (winner.userName||'Utilisateur') + '</div>' +
            '<div style="font-size:12px;color:#888">' + (winner.mood||'Smart casual') + ' · ❤ ' + (winner.likes?winner.likes.length:0) + ' likes</div>' +
            '<div style="font-size:11px;color:var(--purple-light);margin-top:4px">🎁 Gagnant du mois — 1 mois Premium offert</div></div>' +
          '</div>';
        } else {
          winnerEl.innerHTML = '<div style="font-size:13px;color:#888">Aucun vote ce mois-ci · Partagez des tenues pour voter !</div>';
        }
      }

      // Utilisateurs récents
      var usersEl = document.getElementById('dashRecentUsers');
      if (usersEl) {
        if (!users.length) {
          usersEl.innerHTML = '<div style="font-size:13px;color:#888;text-align:center;padding:16px">Aucun utilisateur inscrit</div>';
        } else {
          usersEl.innerHTML = users.slice(0,8).map(function(u) {
            var initial = (u.name || u.email || 'U').charAt(0).toUpperCase();
            return '<div class="dash-user-row">' +
              '<div class="dash-user-avatar">' + initial + '</div>' +
              '<div class="dash-user-info">' +
                '<div class="dash-user-name">' + (u.name || 'Utilisateur') + '</div>' +
                '<div class="dash-user-email">' + (u.email || '') + '</div>' +
              '</div>' +
              '<div class="dash-user-badge">Gratuit</div>' +
            '</div>';
          }).join('');
        }
      }

    } else {
      // Mode démo sans Firebase
      setDashVal('dashTotalUsers', '3');
      setDashVal('dashUsersToday', 'dont toi !');
      setDashVal('dashTotalPosts', '2');
      setDashVal('dashTotalLikes', '5');
      setDashVal('dashRevenue', '0€');
      setDashVal('dashTotalOutfits', '4');
      setDashVal('dashTotalPostsCard', '2');
      setDashVal('dashTotalComments', '1');
      setDashVal('dashTotalLikesCard', '5');
      setDashVal('dashStyleSubs', '0');
      setDashVal('dashPremiumSubs', '0');
      setDashVal('dashMonthlyRevenue', '0€/mois');
      document.getElementById('dashMonthWinner').innerHTML = '<div style="font-size:13px;color:#888">Firebase non connecté — mode démo</div>';
      document.getElementById('dashTopPosts').innerHTML = '<div style="font-size:13px;color:#888;text-align:center;padding:16px">Connectez Firebase pour voir les données</div>';
      document.getElementById('dashRecentUsers').innerHTML = '<div style="font-size:13px;color:#888;text-align:center;padding:16px">Connectez Firebase pour voir les utilisateurs</div>';
    }
  } catch(e) {
    console.error('Dashboard error:', e);
    showToast('Erreur chargement dashboard');
  }

  if (spinner) spinner.style.display = 'none';
  if (refreshText) refreshText.textContent = '🔄 Actualiser les données';
}

function setDashVal(id, val) {
  var el = document.getElementById(id);
  if (el) el.textContent = val;
}

/* ══ VÉRIFICATION ABONNEMENT ══ */
var userPlan = 'free'; // 'free', 'style', 'premium', 'creator'

async function checkSubscription(user) {
  var isCreator = user.email && user.email.toLowerCase() === CREATOR_EMAIL.toLowerCase();
  if (isCreator) { userPlan = 'creator'; return; }

  if (!db) return;
  try {
    var doc = await db.collection('subscriptions').doc(user.uid).get();
    if (doc.exists) {
      var data = doc.data();
      var now = new Date();
      var expires = data.expiresAt ? data.expiresAt.toDate() : null;
      if (data.status === 'active' && expires && expires > now) {
        userPlan = data.plan || 'free';
        applyPlanUI(userPlan);
        console.log('✅ Plan actif:', userPlan);
      } else {
        userPlan = 'free';
        console.log('Plan expiré ou inactif');
      }
    } else {
      userPlan = 'free';
    }
  } catch(e) {
    console.warn('checkSubscription error:', e.message);
  }
}

function applyPlanUI(plan) {
  // Mettre à jour le badge abonnement dans settings
  var subVal = document.querySelector('.setting-value');
  var planNames = {free:'Gratuit', style:'Style ✦', premium:'Premium 👑', creator:'Créateur 👑'};

  // Mettre à jour toutes les valeurs "Gratuit" en settings
  document.querySelectorAll('.setting-value').forEach(function(el) {
    if (el.textContent === 'Gratuit' || el.textContent === 'Free' || el.textContent === 'Gratis') {
      el.textContent = planNames[plan] || 'Gratuit';
      if (plan !== 'free') el.style.color = 'var(--purple-light)';
    }
  });

  // Mettre à jour les boutons Stripe dans l'onglet Plans
  if (plan === 'style') {
    document.querySelectorAll('.sub-cta').forEach(function(btn) {
      if (btn.textContent.includes('Style')) {
        btn.textContent = '✓ Plan actuel';
        btn.style.background = 'var(--card2)';
        btn.style.border = '1px solid var(--purple)';
        btn.style.color = 'var(--purple-light)';
        btn.onclick = function(){ showToast('Vous êtes déjà abonné Style !'); };
      }
    });
  } else if (plan === 'premium') {
    document.querySelectorAll('.sub-cta').forEach(function(btn) {
      if (btn.textContent.includes('Premium') || btn.textContent.includes('Style')) {
        btn.textContent = btn.textContent.includes('Premium') ? '✓ Plan actuel' : '✓ Inclus';
        btn.style.background = 'var(--card2)';
        btn.style.border = '1px solid var(--purple)';
        btn.style.color = 'var(--purple-light)';
        btn.onclick = function(){ showToast('Vous êtes déjà abonné Premium !'); };
      }
    });
  }

  // Limites selon le plan
  if (plan === 'free') {
    window.MAX_OUTFITS_PER_MONTH = 5;
    window.MAX_CLOTHES = 20;
  } else if (plan === 'style') {
    window.MAX_OUTFITS_PER_MONTH = 50;
    window.MAX_CLOTHES = 100;
    showToast('✦ Plan Style actif — Profitez de vos 50 tenues !');
  } else if (plan === 'premium') {
    window.MAX_OUTFITS_PER_MONTH = 999;
    window.MAX_CLOTHES = 999;
    showToast('👑 Plan Premium actif — Tout est illimité !');
  }
}

function checkOutfitLimit() {
  var max = window.MAX_OUTFITS_PER_MONTH || 5;
  if (userPlan === 'creator' || userPlan === 'premium') return true;
  var monthKey = 'dc_outfits_' + new Date().getMonth() + '_' + new Date().getFullYear();
  var count = parseInt(localStorage.getItem(monthKey) || '0');
  if (count >= max) {
    showToast('Limite atteinte ! Passez au plan ' + (max === 5 ? 'Style' : 'Premium'));
    switchTab('sub');
    return false;
  }
  localStorage.setItem(monthKey, count + 1);
  return true;
}

/* ══ ÉLECTION TENUE DU MOIS ══ */

function checkMonthlyWinner() {
  if (!db) return;
  var now = new Date();
  var lastCheck = localStorage.getItem('dc_winner_check');
  var currentMonth = now.getMonth() + '-' + now.getFullYear();

  // Vérifier une seule fois par mois
  if (lastCheck === currentMonth) return;

  // Vérifier si c'est le 1er du mois
  if (now.getDate() !== 1) return;

  localStorage.setItem('dc_winner_check', currentMonth);
  announceMonthlyWinner(now);
}

async function announceMonthlyWinner(now) {
  if (!db) return;
  try {
    // Mois précédent
    var prevDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    var prevMonth = prevDate.getMonth() + '-' + prevDate.getFullYear();

    // Récupérer les posts du mois précédent
    var snap = await db.collection('community_posts').get();
    var posts = [];
    snap.forEach(function(doc) {
      var d = Object.assign({id: doc.id}, doc.data());
      if (d.month === prevMonth) posts.push(d);
    });

    if (!posts.length) return;

    // Trouver le gagnant (plus de likes)
    posts.sort(function(a,b){
      return (b.likes?b.likes.length:0) - (a.likes?a.likes.length:0);
    });
    var winner = posts[0];
    var winnerLikes = winner.likes ? winner.likes.length : 0;
    if (winnerLikes === 0) return;

    // Marquer comme gagnant dans Firestore
    await db.collection('community_posts').doc(winner.id).update({
      isWinner: true,
      wonMonth: prevMonth
    });

    // Sauvegarder le gagnant du mois
    await db.collection('monthly_winners').doc(prevMonth).set({
      userId: winner.userId,
      userName: winner.userName,
      userEmail: winner.userEmail || '',
      mood: winner.mood,
      likes: winnerLikes,
      month: prevMonth,
      announcedAt: new Date().toISOString(),
      prize: '1 mois Premium offert'
    });

    // Activer 1 mois Premium pour le gagnant
    if (winner.userId) {
      var expiresAt = new Date();
      expiresAt.setMonth(expiresAt.getMonth() + 1);
      await db.collection('subscriptions').doc(winner.userId).set({
        uid: winner.userId,
        plan: 'premium',
        status: 'active',
        activatedAt: new Date().toISOString(),
        expiresAt: expiresAt.toISOString(),
        reason: 'tenue_du_mois'
      }, { merge: true });

      await db.collection('users').doc(winner.userId).set({
        plan: 'premium',
        planStatus: 'active',
        planWonMonth: prevMonth
      }, { merge: true });
    }

    // Afficher la bannière gagnant à tous les utilisateurs
    showWinnerBanner(winner, prevMonth);

    // Si c'est l'utilisateur courant qui a gagné
    if (currentUser && winner.userId === currentUser.uid) {
      showPersonalWinnerNotif(winner);
    }

    console.log('✅ Gagnant du mois annoncé:', winner.userName);

  } catch(e) {
    console.error('announceMonthlyWinner error:', e);
  }
}

function closeWinnerNotif(btn) {
  var el = btn;
  while (el && el.style && !el.style.cssText.includes('fixed')) {
    el = el.parentElement;
  }
  if (el) el.remove();
}

function closeWinnerBanner() {
  var b = document.getElementById('winnerBanner');
  if (b) b.remove();
}

function showWinnerBanner(winner, month) {
  // Créer une bannière festive
  var banner = document.createElement('div');
  banner.id = 'winnerBanner';
  banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:800;' +
    'background:linear-gradient(135deg,#7e22ce,#a855f7,#ec4899);' +
    'padding:14px 16px;display:flex;align-items:center;gap:12px;' +
    'box-shadow:0 4px 20px rgba(0,0,0,0.4);animation:fadeUp .5s both;';

  var monthNames = {
    fr: ['Janvier','Février','Mars','Avril','Mai','Juin',
         'Juillet','Août','Septembre','Octobre','Novembre','Décembre']
  };
  var parts = month.split('-');
  var monthName = monthNames.fr[parseInt(parts[0])] + ' ' + parts[1];

  banner.innerHTML =
    '<div style="font-size:28px">🏆</div>' +
    '<div style="flex:1">' +
      '<div style="font-size:13px;font-weight:600;color:#fff">' +
        '✦ Tenue du mois de ' + monthName + ' !</div>' +
      '<div style="font-size:12px;color:rgba(255,255,255,0.85)">' +
        (winner.userName||'Utilisateur') + ' remporte 1 mois Premium ! (' +
        (winner.likes?winner.likes.length:0) + ' likes)</div>' +
    '</div>' +
    '<button onclick="closeWinnerBanner()" ' +
      'style="background:rgba(255,255,255,0.2);border:none;width:28px;height:28px;' +
      'border-radius:50%;color:#fff;font-size:14px;cursor:pointer">✕</button>';

  document.body.appendChild(banner);

  // Disparaît après 8 secondes
  setTimeout(function() {
    var b = document.getElementById('winnerBanner');
    if (b) { b.style.opacity = '0'; b.style.transition = 'opacity .5s'; setTimeout(function(){ b.remove(); }, 500); }
  }, 8000);
}

function showPersonalWinnerNotif(winner) {
  // Notification spéciale pour le gagnant lui-même
  setTimeout(function() {
    var notif = document.createElement('div');
    notif.style.cssText = 'position:fixed;inset:0;z-index:900;' +
      'background:rgba(0,0,0,0.8);display:flex;align-items:center;' +
      'justify-content:center;padding:24px;animation:fadeUp .3s both;';

    notif.innerHTML =
      '<div style="background:linear-gradient(135deg,#7e22ce,#a855f7,#ec4899);' +
        'border-radius:24px;padding:32px;max-width:320px;width:100%;text-align:center;' +
        'box-shadow:0 20px 60px rgba(0,0,0,0.5)">' +
        '<div style="font-size:64px;margin-bottom:16px">🏆</div>' +
        '<div style="font-family:Playfair Display,serif;font-size:24px;' +
          'color:#fff;font-weight:700;margin-bottom:8px">Félicitations !</div>' +
        '<div style="font-size:14px;color:rgba(255,255,255,0.9);margin-bottom:6px">' +
          'Votre tenue <strong>' + (winner.mood||'') + '</strong><br/>' +
          'a remporté la tenue du mois !</div>' +
        '<div style="font-size:13px;color:rgba(255,255,255,0.75);margin-bottom:20px">' +
          '❤ ' + (winner.likes?winner.likes.length:0) + ' likes · ' +
          '🎁 1 mois Premium offert</div>' +
        '<button onclick="closeWinnerNotif(this)" ' +
          'style="width:100%;padding:14px;background:#fff;border:none;' +
          'border-radius:50px;font-size:15px;font-weight:600;' +
          'color:#92400E;cursor:pointer;font-family:Outfit,sans-serif">' +
          '🎉 Merci !</button>' +
      '</div>';

    document.body.appendChild(notif);

    // Envoyer une notification push si activée
    if (notifEnabled && Notification.permission === 'granted') {
      new Notification('DressCode 🏆', {
        body: 'Votre tenue a remporté le mois ! 1 mois Premium vous a été offert.',
        icon: '/favicon.ico'
      });
    }
  }, 2000);
}

// Vérifier aussi si l'utilisateur courant a gagné ce mois
async function checkIfCurrentUserWon() {
  if (!db || !currentUser) return;
  try {
    var now = new Date();
    var prevDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    var prevMonth = prevDate.getMonth() + '-' + prevDate.getFullYear();

    var winnerDoc = await db.collection('monthly_winners').doc(prevMonth).get();
    if (winnerDoc.exists) {
      var data = winnerDoc.data();
      var shownKey = 'dc_winner_shown_' + prevMonth;
      if (data.userId === currentUser.uid && !localStorage.getItem(shownKey)) {
        localStorage.setItem(shownKey, '1');
        showPersonalWinnerNotif(data);
      }
      // Afficher la bannière à tous si pas encore vue
      var bannerKey = 'dc_banner_shown_' + prevMonth;
      if (!localStorage.getItem(bannerKey)) {
        localStorage.setItem(bannerKey, '1');
        showWinnerBanner(data, prevMonth);
      }
    }
  } catch(e) {
    console.warn('checkIfCurrentUserWon error:', e);
  }
}

/* ══ AVATAR CUSTOMIZER ══ */
var avatarConfig = {
  skin: '#FDDCB5', eyes: '#2C1810', hair: '#2C1810',
  hairstyle: 'short', shirt: '#6D28D9', topstyle: 'tshirt',
  pants: '#1a1a2e', bottomstyle: 'jeans',
  shoes: '#2C2C2A', shoestyle: 'sneakers',
  glasses: 'none', hat: 'none'
};

function switchAvTab(btn, panel) {
  document.querySelectorAll('.av-tab').forEach(function(b){ b.classList.remove('active'); });
  document.querySelectorAll('.av-panel').forEach(function(p){ p.classList.remove('active'); });
  btn.classList.add('active');
  var p = document.getElementById('avp-' + panel);
  if (p) p.classList.add('active');
}

function setAv(el) {
  var type = el.dataset.type;
  var val = el.dataset.val;
  el.closest('.av-color-row').querySelectorAll('.av-swatch').forEach(function(s){ s.classList.remove('selected'); });
  el.classList.add('selected');
  avatarConfig[type] = val;
  renderAvatar();
}

function setAvStyle(el) {
  var type = el.dataset.type;
  var val = el.dataset.val;
  el.closest('.av-style-grid').querySelectorAll('.av-style-card').forEach(function(s){ s.classList.remove('selected'); });
  el.classList.add('selected');
  avatarConfig[type] = val;
  renderAvatar();
}

function renderAvatar() {
  var svg = document.getElementById('mainAvatar');
  if (!svg) return;

  // Peau
  // Mettre à jour le gradient de peau
  var skinTop = document.getElementById('skinTop');
  var skinBot = document.getElementById('skinBot');
  if (skinTop) skinTop.setAttribute('stop-color', avatarConfig.skin);
  if (skinBot) {
    // Version légèrement plus foncée pour le bas
    skinBot.setAttribute('stop-color', avatarConfig.skin);
  }
  var skinEls = ['av-ear-l','av-ear-r','av-hand-l','av-hand-r'];
  skinEls.forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.setAttribute('fill', avatarConfig.skin);
  });

  // Yeux
  ['av-eye-l','av-eye-r'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.setAttribute('fill', avatarConfig.eyes);
  });
  ['av-brow-l','av-brow-r'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.setAttribute('stroke', avatarConfig.hair);
  });

  // Cheveux
  var hair = document.getElementById('av-hair');
  if (hair) {
    hair.setAttribute('fill', avatarConfig.hair);
    var styles = {
      short: 'M44 48 Q44 16 80 12 Q116 16 116 48 Q116 32 80 28 Q44 32 44 48Z',
      medium: 'M44 48 Q44 16 80 12 Q116 16 116 48 Q116 28 80 24 Q44 28 44 48 M44 48 Q38 72 40 88 M116 48 Q122 72 120 88Z',
      long: 'M44 48 Q44 16 80 12 Q116 16 116 48 Q116 26 80 22 Q44 26 44 48 M44 48 Q36 80 38 110 M116 48 Q124 80 122 110Z',
      curly: 'M44 48 Q44 16 80 12 Q116 16 116 48 Q110 30 95 28 Q85 20 80 22 Q75 20 65 28 Q50 30 44 48 M50 30 Q44 22 50 16 M110 30 Q116 22 110 16Z',
      bun: 'M44 48 Q44 20 80 16 Q116 20 116 48 Q116 34 80 30 Q44 34 44 48 M80 16 Q80 2 90 6 Q98 10 90 16Z',
      none: ''
    };
    hair.setAttribute('d', styles[avatarConfig.hairstyle] || styles.short);
  }

  // Haut
  var shirt = document.getElementById('av-shirt');
  var armL = document.getElementById('av-arm-l');
  var armR = document.getElementById('av-arm-r');
  var collar = document.getElementById('av-collar');
  if (shirt) shirt.setAttribute('fill', avatarConfig.shirt);
  if (armL) armL.setAttribute('fill', avatarConfig.shirt);
  if (armR) armR.setAttribute('fill', avatarConfig.shirt);
  if (collar) collar.setAttribute('fill', avatarConfig.shirt);
  // Mettre à jour le gradient aussi
  var shirtGradTop = svg.querySelector('#shirtGrad stop:first-child');
  var shirtGradBot = svg.querySelector('#shirtGrad stop:last-child');
  if (shirtGradTop) shirtGradTop.setAttribute('stop-color', avatarConfig.shirt);
  if (shirtGradBot) shirtGradBot.setAttribute('stop-color', avatarConfig.shirt);

  // Style haut
  if (shirt) {
    var topStyles = {
      tshirt: {h:94, rx:20}, shirt: {h:94, rx:20},
      hoodie: {h:106, rx:24}, dress: {h:150, rx:24}
    };
    var ts = topStyles[avatarConfig.topstyle] || topStyles.tshirt;
    shirt.setAttribute('height', ts.h);
    shirt.setAttribute('rx', ts.rx);
  }

  // Bas
  var legL = document.getElementById('av-leg-l');
  var legR = document.getElementById('av-leg-r');
  if (legL) legL.setAttribute('fill', avatarConfig.pants);
  if (legR) legR.setAttribute('fill', avatarConfig.pants);

  // Style bas
  if (legL && legR) {
    var bottomStyles = {
      jeans: {h:86, y:188, rx:15},
      shorts: {h:44, y:188, rx:15},
      skirt: {h:70, y:188, rx:22},
      sweat: {h:86, y:188, rx:12}
    };
    var bs = bottomStyles[avatarConfig.bottomstyle] || bottomStyles.jeans;
    legL.setAttribute('height', bs.h);
    legL.setAttribute('y', bs.y);
    legL.setAttribute('rx', bs.rx);
    legR.setAttribute('height', bs.h);
    legR.setAttribute('y', bs.y);
    legR.setAttribute('rx', bs.rx);
    // Chaussures position
    var shoeL2 = document.getElementById('av-shoe-l2');
    var shoeR2 = document.getElementById('av-shoe-r2');
    if (shoeL2) shoeL2.setAttribute('y', Math.min(268, bs.y + bs.h + 4));
    if (shoeR2) shoeR2.setAttribute('y', Math.min(268, bs.y + bs.h + 4));
  }

  // Chaussures couleur
  ['av-shoe-l','av-shoe-r','av-shoe-l2','av-shoe-r2'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.setAttribute('fill', avatarConfig.shoes);
  });

  // Lunettes
  var glassesG = document.getElementById('av-glasses');
  if (glassesG) {
    if (avatarConfig.glasses === 'none') {
      glassesG.innerHTML = '';
    } else if (avatarConfig.glasses === 'round') {
      glassesG.innerHTML = '<circle cx="68" cy="57" r="9" fill="none" stroke="#1a1a1a" stroke-width="2.5"/><circle cx="92" cy="57" r="9" fill="none" stroke="#1a1a1a" stroke-width="2.5"/><line x1="77" y1="57" x2="83" y2="57" stroke="#1a1a1a" stroke-width="2"/><line x1="44" y1="55" x2="59" y2="55" stroke="#1a1a1a" stroke-width="2"/><line x1="101" y1="55" x2="116" y2="55" stroke="#1a1a1a" stroke-width="2"/>';
    } else if (avatarConfig.glasses === 'sun') {
      glassesG.innerHTML = '<rect x="58" y="51" width="20" height="13" rx="4" fill="#1a1a1a" opacity="0.8"/><rect x="82" y="51" width="20" height="13" rx="4" fill="#1a1a1a" opacity="0.8"/><line x1="78" y1="57" x2="82" y2="57" stroke="#1a1a1a" stroke-width="2"/><line x1="44" y1="54" x2="58" y2="54" stroke="#1a1a1a" stroke-width="2"/><line x1="102" y1="54" x2="116" y2="54" stroke="#1a1a1a" stroke-width="2"/>';
    }
  }

  // Chapeau
  var hatG = document.getElementById('av-hat');
  if (hatG) {
    if (avatarConfig.hat === 'none') {
      hatG.innerHTML = '';
    } else if (avatarConfig.hat === 'cap') {
      hatG.innerHTML = '<rect x="44" y="22" width="72" height="26" rx="10" fill="#1a1a1a"/><rect x="38" y="38" width="84" height="8" rx="4" fill="#1a1a1a"/><rect x="80" y="14" width="14" height="12" rx="4" fill="#1a1a1a"/>';
    } else if (avatarConfig.hat === 'beanie') {
      hatG.innerHTML = '<path d="M44 44 Q44 12 80 10 Q116 12 116 44 Q110 30 80 28 Q50 30 44 44Z" fill="#6D28D9"/><rect x="42" y="40" width="76" height="10" rx="5" fill="#5B21B6"/>';
    }
  }

  // Aussi mettre à jour l'avatar dans le résultat de tenue
  updateOutfitAvatar();
}

function updateOutfitAvatar() {
  var oaSvg = document.getElementById('outfitAvatarSvg');
  if (!oaSvg) return;
  var skinEls2 = ['oaHead','oaNeck'];
  skinEls2.forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.setAttribute('fill', avatarConfig.skin);
  });
  var oaHair = document.getElementById('oaHair');
  if (oaHair) oaHair.setAttribute('fill', avatarConfig.hair);
}

function randomizeAvatar() {
  var skins = ['#FDDCB5','#F0C27F','#D4915A','#A0522D','#6B3A2A','#3D1C0D'];
  var hairs = ['#2C1810','#1a1a1a','#C68642','#e8d5b7','#c0392b','#6D28D9'];
  var colors = ['#6D28D9','#1a1a1a','#fff','#1D4ED8','#DC2626','#16A34A','#F59E0B','#EC4899'];
  var hstyles = ['short','medium','long','curly','bun'];
  var tstyles = ['tshirt','shirt','hoodie'];
  var bstyles = ['jeans','shorts','sweat'];
  avatarConfig.skin = skins[Math.floor(Math.random()*skins.length)];
  avatarConfig.hair = hairs[Math.floor(Math.random()*hairs.length)];
  avatarConfig.hairstyle = hstyles[Math.floor(Math.random()*hstyles.length)];
  avatarConfig.shirt = colors[Math.floor(Math.random()*colors.length)];
  avatarConfig.topstyle = tstyles[Math.floor(Math.random()*tstyles.length)];
  avatarConfig.pants = colors[Math.floor(Math.random()*colors.length)];
  avatarConfig.bottomstyle = bstyles[Math.floor(Math.random()*bstyles.length)];
  renderAvatar();
  showToast('Avatar aléatoire généré ! 🎲');
}

function saveAvatarConfig() {
  try {
    localStorage.setItem('dc_avatar_config', JSON.stringify(avatarConfig));
    if (db && currentUser) {
      db.collection('users').doc(currentUser.uid).set({
        avatarConfig: avatarConfig
      }, {merge: true});
    }
    showToast('Avatar sauvegardé ! ✦');
  } catch(e) { showToast('Erreur sauvegarde'); }
}

function loadAvatarConfig() {
  // Depuis Firestore
  if (db && currentUser) {
    db.collection('users').doc(currentUser.uid).get().then(function(doc) {
      if (doc.exists && doc.data().avatarConfig) {
        avatarConfig = Object.assign(avatarConfig, doc.data().avatarConfig);
        renderAvatar();
      } else {
        loadAvatarFromLocal();
      }
    }).catch(function(){ loadAvatarFromLocal(); });
  } else {
    loadAvatarFromLocal();
  }
}

function loadAvatarFromLocal() {
  try {
    var saved = JSON.parse(localStorage.getItem('dc_avatar_config') || '{}');
    if (Object.keys(saved).length > 0) {
      avatarConfig = Object.assign(avatarConfig, saved);
      renderAvatar();
    }
  } catch(e) {}
}

function saveApiKey() {
  var val = document.getElementById('apiKeyInput').value.trim();
  if (!val || val === '••••••••') { showToast('Entrez votre cle API'); return; }
  ANTHROPIC_API_KEY = val;
  localStorage.setItem('dc_api_key', val);
  document.getElementById('apiKeyInput').value = '••••••••';
  showToast('Cle API enregistree !');
}

// ── TOAST ──
var toastTimer;
function showToast(msg) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function() { t.classList.remove('show'); }, 2800);
}
</script>

