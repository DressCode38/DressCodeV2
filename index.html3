        <div class="setting-row" onclick="openLangModal()">
          <div class="setting-left"><div class="setting-icon">🌐</div><div class="setting-label" data-i18n="language">Langue</div></div>
          <div style="display:flex;align-items:center;gap:6px"><div class="setting-value" id="currentLangLabel">Français</div><div class="setting-arrow">›</div></div>
