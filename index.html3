/* ── COMPTE CRÉATEUR ── */
function applyCreatorMode() {
  console.log('✦ Mode Créateur activé');
  var creatorBadge = document.getElementById('creatorBadge');
  if (creatorBadge) creatorBadge.style.display = 'flex';

  // Badge créateur dans le header
  var badge = document.getElementById('userBadge');
  if (badge) {
    badge.style.background = 'linear-gradient(135deg,#2D1B69,#6D28D9,#a855f7)';
    badge.style.border = '2px solid #c084fc';
    badge.title = 'Compte Créateur ✦';
  }

  // Accès Premium unlocked — afficher badge sur abonnements
  var subTitle = document.querySelector('#panelSub .section-sub');
  if (subTitle) subTitle.innerHTML = '✦ <strong style="color:var(--purple-light)">Compte Créateur</strong> — Accès Premium illimité';

  // Cacher les boutons Stripe (pas besoin de payer)
  document.querySelectorAll('.sub-cta').forEach(function(btn) {
    if (btn.textContent.includes('Style') || btn.textContent.includes('Premium')) {
      btn.textContent = '✦ Déjà activé';
      btn.style.background = 'linear-gradient(135deg,#F97316,#F43F5E)';
      btn.style.border = 'none';
      btn.onclick = function() { showToast('✦ Compte Créateur — Accès illimité !'); };
    }
  });

  // Montrer la clé API dans les réglages (visible uniquement pour le créateur)
  var apiSection = document.querySelector('.api-key-section');
  if (apiSection) apiSection.style.display = 'block';

  // Tenues illimitées
  showToast('✦ Bienvenue Créateur ! Accès Premium activé');

  // Ajouter bouton dashboard dans settings
  var dashBtn = document.getElementById('creatorDashBtn');
  if (!dashBtn) {
    var creatorBadge = document.getElementById('creatorBadge');
    if (creatorBadge) {
      var btn = document.createElement('button');
      btn.id = 'creatorDashBtn';
      btn.onclick = openDashboard;
      btn.style.cssText = 'width:100%;padding:13px;background:linear-gradient(135deg,#C2410C,#F97316,#F43F5E);border:none;border-radius:var(--radius-sm);color:#fff;font-size:14px;font-weight:500;cursor:pointer;font-family:\'Outfit\',sans-serif;margin-top:10px;display:flex;align-items:center;justify-content:center;gap:8px;';
      btn.innerHTML = '📊 Ouvrir le tableau de bord';
      creatorBadge.parentNode.insertBefore(btn, creatorBadge.nextSibling);
    }
  }
}

function applyUserMode() {
  // Cacher la section clé API pour les utilisateurs normaux
  var apiSection = document.querySelector('.api-key-section');
  if (apiSection) apiSection.style.display = 'none';
}

/* ══════════════════════════════════════
   SYSTÈME SOCIAL - COMMUNAUTÉ
══════════════════════════════════════ */

// Partager la dernière tenue générée
function shareLastOutfit() {
  if (!currentUser) { showToast('Connectez-vous dabord'); return; }
  if (outfitHistory.length === 0) {
    showToast('Generez dabord une tenue dans le Dressing !');
    return;
  }
  var last = outfitHistory[0];
  var post = {
    userId: currentUser.uid,
    userEmail: currentUser.email || '',
    userName: currentUser.displayName || currentUser.email.split('@')[0] || 'Utilisateur',
    mood: last.mood || 'Smart casual',
    items: last.items || [],
    conseil: last.conseil || '',
    date: new Date().toISOString(),
    likes: [],
    comments: [],
    month: new Date().getMonth() + '-' + new Date().getFullYear()
  };

  if (db) {
    db.collection('community_posts').add(post).then(function(ref) {
      showToast('Tenue partagee avec la communaute !');
      renderCommunityFeed();
    }).catch(function(e) {
      showToast('Erreur partage: ' + e.message);
    });
  } else {
    // Mode demo sans Firebase
    var demoPost = Object.assign({}, post, {id: Date.now().toString()});
    var demo = JSON.parse(localStorage.getItem('dc_demo_posts') || '[]');
    demo.unshift(demoPost);
    localStorage.setItem('dc_demo_posts', JSON.stringify(demo.slice(0,50)));
    showToast('Tenue partagee !');
    renderCommunityFeed();
  }
}

// Charger et afficher le feed
function renderCommunityFeed() {
  var feed = document.getElementById('communityFeed');
  var empty = document.getElementById('feedEmpty');
  var countEl = document.getElementById('feedCount');
  if (!feed) return;

  if (db) {
    db.collection('community_posts')
      .limit(30)
      .get()
      .then(function(snapshot) {
        var posts = [];
        snapshot.forEach(function(doc) {
          posts.push(Object.assign({id: doc.id}, doc.data()));
        });
        // Trier par date côté client
        posts.sort(function(a,b){ return new Date(b.date) - new Date(a.date); });
        displayFeedPosts(posts, feed, empty, countEl);
        updateMonthWinner(posts);
      }).catch(function(e) {
        console.warn('Feed error:', e);
        loadDemoPosts(feed, empty, countEl);
      });
  } else {
    loadDemoPosts(feed, empty, countEl);
  }
}

function loadDemoPosts(feed, empty, countEl) {
  var demo = JSON.parse(localStorage.getItem('dc_demo_posts') || '[]');
  displayFeedPosts(demo, feed, empty, countEl);
  updateMonthWinner(demo);
}

function displayFeedPosts(posts, feed, empty, countEl) {
  if (countEl) countEl.textContent = posts.length + ' tenue(s)';
  if (posts.length === 0) {
    feed.innerHTML = '';
    if (empty) { feed.appendChild(empty); empty.style.display = 'block'; }
    return;
  }
  var currentMonth = new Date().getMonth() + '-' + new Date().getFullYear();
  var html = posts.map(function(post) {
    var initial = (post.userName || 'U').charAt(0).toUpperCase();
    var isLiked = currentUser && post.likes && post.likes.includes(currentUser.uid);
    var likesCount = post.likes ? post.likes.length : 0;
    var commentsCount = post.comments ? post.comments.length : 0;
    var dateStr = post.date ? new Date(post.date).toLocaleDateString('fr-FR',{day:'2-digit',month:'short'}) : '';
    var isWinner = post.isWinner;
    var catEmojisLocal = {tete:'🧢',haut:'👕',bas:'👖',chaussures:'👟',accessoires:'💍',sac:'👜'};
    var pid = post.id;

    var itemsHtml = '';
    if (post.items && post.items.length) {
      itemsHtml = post.items.slice(0,4).map(function(item) {
        var name = typeof item === 'string' ? item : item.name;
        var color = typeof item === 'object' ? (item.color||'#888') : '#888';
        var cat = typeof item === 'object' ? (item.cat||'haut') : 'haut';
        var emoji = catEmojisLocal[cat] || '👕';
        return '<div class="feed-outfit-item"><div class="feed-item-dot" style="background:' + color + ';border:1px solid rgba(255,255,255,0.2)"></div>' + emoji + ' ' + name + '</div>';
      }).join('');
    }

    return '<div class="feed-post" id="post-' + pid + '" data-post-id="' + pid + '">' +
      '<div class="feed-post-header">' +
        '<div class="feed-avatar">' + initial + '</div>' +
        '<div class="feed-user-info">' +
          '<div class="feed-username">' + (post.userName||'Utilisateur') + (isWinner ? ' <span class="feed-winner-badge">🏆 TENUE DU MOIS</span>' : '') + '</div>' +
          '<div class="feed-date">' + dateStr + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="feed-outfit-card">' +
        '<div class="feed-outfit-mood">✦ ' + (post.mood||'Smart casual') + '</div>' +
        '<div class="feed-outfit-items">' + itemsHtml + '</div>' +
        (post.conseil ? '<div style="font-size:11px;color:#888;margin-top:8px;border-top:1px solid var(--border2);padding-top:8px">💡 ' + post.conseil + '</div>' : '') +
      '</div>' +
      '<div class="feed-actions">' +
        '<button class="feed-action-btn ' + (isLiked?'liked':'') + '" data-action="like" data-pid="' + pid + '">' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="' + (isLiked?'currentColor':'none') + '" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
          '<span id="likes-' + pid + '">' + likesCount + '</span>' +
        '</button>' +
        '<div class="feed-action-divider"></div>' +
        '<button class="feed-action-btn" data-action="comment" data-pid="' + pid + '">' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
          '<span id="comments-count-' + pid + '">' + commentsCount + '</span>' +
        '</button>' +
      '</div>' +
      '<div class="feed-comments-section" id="comments-' + pid + '">' +
        renderComments(post) +
        '<div class="feed-comment-input-wrap">' +
          '<input class="feed-comment-input" id="comment-input-' + pid + '" placeholder="Votre commentaire..." />' +
          '<button class="feed-comment-send" data-action="send" data-pid="' + pid + '">➤</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  }).join('');

  feed.innerHTML = html;

  // Attacher les événements après insertion dans le DOM
  document.querySelectorAll('[data-action="like"]').forEach(function(btn) {
    btn.addEventListener('click', function() { toggleLike(this.dataset.pid); });
  });
  document.querySelectorAll('[data-action="comment"]').forEach(function(btn) {
    btn.addEventListener('click', function() { toggleComments(this.dataset.pid); });
  });
  document.querySelectorAll('[data-action="send"]').forEach(function(btn) {
    btn.addEventListener('click', function() { addComment(this.dataset.pid); });
  });
  // Soumettre avec Entrée
  document.querySelectorAll('.feed-comment-input').forEach(function(input) {
    input.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        var pid = this.id.replace('comment-input-', '');
        addComment(pid);
      }
    });
  });
}


function renderComments(post) {
  if (!post.comments || !post.comments.length) return '';
  return post.comments.slice(-5).map(function(c) {
    var initial = (c.userName||'U').charAt(0).toUpperCase();
    return '<div class="feed-comment">' +
      '<div class="feed-comment-avatar">' + initial + '</div>' +
      '<div class="feed-comment-bubble">' +
        '<div class="feed-comment-name">' + (c.userName||'Utilisateur') + '</div>' +
        '<div class="feed-comment-text">' + c.text + '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

function toggleComments(postId) {
  var section = document.getElementById('comments-' + postId);
  if (section) section.classList.toggle('open');
}

function toggleLike(postId) {
  if (!currentUser) { showToast('Connectez-vous pour liker'); return; }
  var uid = currentUser.uid;
  var likesEl = document.getElementById('likes-' + postId);
  var btn = likesEl ? likesEl.closest('.feed-action-btn') : null;
  var isLiked = btn && btn.classList.contains('liked');
  var current = parseInt((likesEl && likesEl.textContent) || '0');

  // Update UI immédiatement
  if (btn) btn.classList.toggle('liked', !isLiked);
  if (likesEl) likesEl.textContent = isLiked ? current - 1 : current + 1;
  if (btn) btn.querySelector('svg').setAttribute('fill', isLiked ? 'none' : 'currentColor');

  if (db) {
    var ref = db.collection('community_posts').doc(postId);
    ref.get().then(function(doc) {
      if (!doc.exists) return;
      var data = doc.data();
      var likes = data.likes || [];
      if (isLiked) {
        likes = likes.filter(function(id){ return id !== uid; });
      } else {
        if (likes.indexOf(uid) === -1) likes.push(uid);
      }
      ref.update({likes: likes});
    });
  } else {
    // Mode demo
    var demo = JSON.parse(localStorage.getItem('dc_demo_posts') || '[]');
    var post = demo.find(function(p){ return p.id == postId; });
    if (post) {
      post.likes = post.likes || [];
      if (isLiked) post.likes = post.likes.filter(function(id){ return id !== uid; });
      else post.likes.push(uid);
      localStorage.setItem('dc_demo_posts', JSON.stringify(demo));
    }
  }
}

function addComment(postId) {
  if (!currentUser) { showToast('Connectez-vous pour commenter'); return; }
  var input = document.getElementById('comment-input-' + postId);
  var text = input ? input.value.trim() : '';
  if (!text) return;

  var comment = {
    userId: currentUser.uid,
    userName: currentUser.displayName || currentUser.email.split('@')[0],
    text: text,
    date: new Date().toISOString()
  };

  if (input) input.value = '';
  showToast('Commentaire ajouté !');

  if (db) {
    var ref = db.collection('community_posts').doc(postId);
    ref.get().then(function(doc) {
      if (!doc.exists) return;
      var data = doc.data();
      var comments = data.comments || [];
      comments.push(comment);
      ref.update({comments: comments}).then(function() {
        renderCommunityFeed();
      });
    });
  } else {
    var demo = JSON.parse(localStorage.getItem('dc_demo_posts') || '[]');
    var post = demo.find(function(p){ return p.id == postId; });
    if (post) {
      post.comments = post.comments || [];
      post.comments.push(comment);
      localStorage.setItem('dc_demo_posts', JSON.stringify(demo));
    }
    renderCommunityFeed();
  }
}

// Élection tenue du mois - la tenue avec le plus de likes
function updateMonthWinner(posts) {
  var winnerName = document.getElementById('monthWinnerName');
  var winnerInfo = document.getElementById('monthWinnerInfo');
  var progress = document.getElementById('monthProgress');
  if (!posts.length) return;

  var currentMonth = new Date().getMonth() + '-' + new Date().getFullYear();
  var monthPosts = posts.filter(function(p){ return p.month === currentMonth; });

  if (!monthPosts.length) {
    if (winnerName) winnerName.textContent = 'Aucune tenue ce mois-ci';
    return;
  }

  var sorted = monthPosts.sort(function(a,b){
    return (b.likes?b.likes.length:0) - (a.likes?a.likes.length:0);
  });
  var winner = sorted[0];
  var maxLikes = winner.likes ? winner.likes.length : 0;

  if (winnerName) winnerName.textContent = (winner.userName||'Utilisateur') + ' — ' + (winner.mood||'Smart casual');
  if (winnerInfo) winnerInfo.textContent = maxLikes + ' like(s) · La tenue gagnante remporte 1 mois Premium offert !';
  if (progress) {
    setTimeout(function(){ progress.style.width = Math.min(100, maxLikes * 10) + '%'; }, 300);
  }

  // Marquer le gagnant
  if (maxLikes > 0 && db) {
    db.collection('community_posts').doc(winner.id).update({isWinner: true});
  }

  // Countdown fin de mois
  var now = new Date();
  var endOfMonth = new Date(now.getFullYear(), now.getMonth()+1, 1);
  var daysLeft = Math.ceil((endOfMonth - now) / (1000*60*60*24));
  var countEl = document.getElementById('monthCountdown');
  if (countEl) countEl.textContent = daysLeft + ' jour(s) restant(s) pour voter';
}

/* ══ ONBOARDING ABONNEMENT ══ */
function showOnboarding() {
  var screen = document.getElementById('onboardingSub');
  if (screen) screen.style.display = 'flex';
}

function hideOnboarding() {
  var screen = document.getElementById('onboardingSub');
  if (screen) screen.style.display = 'none';
  localStorage.setItem('dc_onboard_done', '1');
}

function selectOnboardPlan(plan) {
  hideOnboarding();
  if (plan === 'free') {
    showToast('Bienvenue sur DressCode ! Plan gratuit activé ✦');
  }
  // Style et Premium redirigent vers Stripe via les boutons
}

