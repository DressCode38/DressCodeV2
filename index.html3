<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="theme-color" content="#0d0118"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="DressCode"/>
<title>DressCode</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:Outfit,sans-serif;background:#f5f5f5;position:fixed;width:100%}
:root{
  --purple:#a855f7;--purple-light:#c084fc;--purple-dark:#7e22ce;
  --purple-glow:#a855f733;--gold:#ec4899;
  --bg:#f5f5f5;--bg2:#ffffff;--bg3:#f0f0f0;
  --card:#ffffff;--card2:#f8f8f8;
  --text:#0A0A0A;--text2:#333333;--text3:#888888;
  --border:rgba(0,0,0,0.08);--border2:rgba(0,0,0,0.05);
  --radius:16px;--radius-sm:12px;--radius-lg:24px;
  --accent:linear-gradient(135deg,#a855f7,#ec4899);
}
#app{width:100%;height:100%;position:relative;overflow:hidden}
.screen{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;pointer-events:none;transform:translateY(20px);transition:opacity .45s ease,transform .45s ease;overflow:hidden;z-index:1}
.screen.active{opacity:1;pointer-events:all;transform:translateY(0);z-index:10}

/* SPLASH */
#splash{background:var(--bg);justify-content:center;align-items:center}
.splash-orb{position:absolute;border-radius:50%;filter:blur(80px);animation:pulse 4s ease-in-out infinite}
.orb1{width:350px;height:350px;background:rgba(124,58,237,0.35);top:-80px;left:-80px}
.orb2{width:280px;height:280px;background:rgba(167,139,250,0.2);bottom:-60px;right:-60px;animation-delay:1.5s}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
.splash-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:0}
.splash-logo{width:100px;height:100px;background:linear-gradient(135deg,#4c1d95,#7c3aed);border-radius:28px;display:flex;align-items:center;justify-content:center;margin-bottom:28px;box-shadow:0 0 60px var(--purple-glow),0 20px 40px rgba(0,0,0,0.5);animation:logoIn 1s cubic-bezier(.34,1.56,.64,1) both}
@keyframes logoIn{from{transform:scale(0) rotate(-20deg);opacity:0}to{transform:scale(1) rotate(0);opacity:1}}
.splash-name{font-family:Playfair Display,serif;font-size:42px;font-weight:700;color:#0A0A0A;animation:fadeUp .8s .3s both}
.splash-name span{color:var(--purple-light)}
.splash-tagline{font-size:13px;color:#888;letter-spacing:2px;text-transform:uppercase;margin-top:6px;animation:fadeUp .8s .5s both}
.splash-loader{margin-top:60px;width:120px;height:2px;background:#f5f5f5;border-radius:2px;overflow:hidden;animation:fadeUp .8s .7s both}
.splash-loader-bar{height:100%;background:linear-gradient(90deg,var(--purple),var(--purple-light));border-radius:2px;width:0%;transition:width .08s linear}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* AUTH */
#auth{background:var(--bg)}
.auth-orb{position:absolute;border-radius:50%;filter:blur(100px)}
.auth-orb1{width:400px;height:400px;background:rgba(249,115,22,0.2);top:-150px;right:-100px}
.auth-orb2{width:300px;height:300px;background:rgba(244,63,94,0.12);bottom:-100px;left:-80px}
.auth-inner{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;overflow-y:auto;padding:0 0 24px}
.auth-top{padding:50px 28px 30px;display:flex;flex-direction:column;align-items:flex-start}
.auth-logo-small{width:44px;height:44px;background:var(--purple);border-radius:13px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;box-shadow:0 4px 20px var(--purple-glow)}
.auth-title{font-family:Playfair Display,serif;font-size:30px;color:#0A0A0A;font-weight:700;line-height:1.2}
.auth-subtitle{font-size:14px;color:#888;margin-top:6px}
.auth-form{padding:0 24px;display:flex;flex-direction:column;gap:12px;flex:1;position:relative;z-index:20}
.input-group{display:flex;flex-direction:column;gap:6px}
.input-label{font-size:11px;color:#333;font-weight:500;letter-spacing:.5px;text-transform:uppercase;padding-left:4px}
.dc-input{width:100%;padding:15px 18px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:15px;font-family:Outfit,sans-serif;outline:none;transition:border-color .2s,box-shadow .2s}
.dc-input::placeholder{color:#888}
.dc-input:focus{border-color:#a855f7;box-shadow:0 0 0 3px var(--purple-glow)}
.pw-wrap{position:relative}
.pw-wrap .dc-input{padding-right:50px}
.eye-btn{position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#888;font-size:18px;padding:4px;line-height:1}
.remember-row{display:flex;align-items:center;justify-content:space-between;padding:0 2px}
.remember-label{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.checkbox{width:20px;height:20px;border-radius:6px;border:1.5px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0}
.checkbox.checked{background:var(--purple);border-color:#a855f7}
.remember-text{font-size:13px;color:#333}
.forgot-btn{background:none;border:none;color:var(--purple-light);font-size:12px;cursor:pointer;font-family:Outfit,sans-serif}
.dc-btn{width:100%;padding:16px;background:var(--purple);color:#fff;border:none;border-radius:var(--radius-sm);font-size:16px;font-weight:500;font-family:Outfit,sans-serif;cursor:pointer;transition:transform .15s,box-shadow .2s;box-shadow:0 4px 20px var(--purple-glow)}
.dc-btn:active{transform:scale(0.98)}
.dc-btn.loading{opacity:.7;pointer-events:none}
.dc-btn-outline{width:100%;padding:14px;background:transparent;color:var(--purple-light);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:14px;font-family:Outfit,sans-serif;cursor:pointer;transition:background .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.dc-btn-outline:hover{background:#fff}
.auth-divider{display:flex;align-items:center;gap:12px;margin:2px 0}
.auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:var(--border2)}
.auth-divider span{font-size:12px;color:#888}
.auth-error{background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.3);border-radius:var(--radius-sm);padding:12px 16px;font-size:13px;color:#f87171;display:none}
.auth-error.visible{display:block}
.auth-switch-text{text-align:center;font-size:12px;color:#888}
.auth-switch-text button{background:none;border:none;color:var(--purple-light);font-size:12px;cursor:pointer;font-family:Outfit,sans-serif;text-decoration:underline}

/* MAIN APP */
#main{background:var(--bg)}
.app-header{background:linear-gradient(180deg,var(--bg2),var(--bg));border-bottom:1px solid var(--border2);padding:14px 20px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding-top:calc(env(safe-area-inset-top,0px) + 14px)}
.app-header-left{display:flex;align-items:center;gap:10px}
.header-logo{width:30px;height:30px;background:linear-gradient(135deg,#2D1B69 0%,#6D28D9 40%,#a855f7 70%,#c084fc 100%);border-radius:9px;display:flex;align-items:center;justify-content:center}
.user-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--purple-light));display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;font-weight:500;border:1.5px solid var(--border)}
.tab-area{flex:1;overflow:hidden;position:relative}
.tab-panel{position:absolute;inset:0;overflow-y:auto;padding:20px 16px;opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .3s,transform .3s;-webkit-overflow-scrolling:touch}
.tab-panel.active{opacity:1;pointer-events:all;transform:translateY(0)}
.bottom-nav{background:var(--bg2);border-top:1px solid var(--border2);display:grid;grid-template-columns:repeat(4,1fr);padding:8px 0 calc(env(safe-area-inset-bottom,0px) + 8px);flex-shrink:0}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 4px;cursor:pointer;transition:transform .15s}
.nav-item:active{transform:scale(0.9)}
.nav-icon-wrap{width:44px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:14px;transition:background .2s}
.nav-item.active .nav-icon-wrap{background:rgba(124,58,237,0.2)}
.nav-svg{width:22px;height:22px;stroke:var(--text3);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:stroke .2s}
.nav-item.active .nav-svg{stroke:var(--purple-light)}
.nav-label{font-size:9px;color:#888;transition:color .2s}
.nav-item.active .nav-label{color:var(--purple-light);font-weight:500}
.section-title{font-family:Playfair Display,serif;font-size:22px;color:#0A0A0A;font-weight:700;margin-bottom:4px}
.section-sub{font-size:13px;color:#888;margin-bottom:20px}

/* DRESSING */
.ai-card{background:linear-gradient(135deg,#2D1B69 0%,#6D28D9 40%,#a855f7 70%,#c084fc 100%);border-radius:var(--radius);padding:20px;margin-bottom:16px;position:relative;overflow:hidden;}
.ai-card::before{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,0.08)}
.ai-card h3{font-family:Outfit,sans-serif;font-size:17px;font-weight:700;color:#fff;margin-bottom:4px;position:relative;letter-spacing:-0.3px}
.ai-card p{font-size:13px;color:rgba(255,255,255,0.7);margin-bottom:16px;position:relative}
.ai-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;background:#fff;color:var(--purple-dark);border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:500;font-family:Outfit,sans-serif;cursor:pointer;transition:transform .15s;position:relative}
.ai-btn:active{transform:scale(0.97)}
.dressing-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.dressing-header h3{font-size:15px;color:#0A0A0A;font-weight:500}
.add-photo-btn{display:flex;align-items:center;gap:6px;padding:8px 14px;background:#fff;border:1px dashed var(--border);border-radius:var(--radius-sm);color:var(--purple-light);font-size:13px;cursor:pointer}
.clothes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.cloth-item{background:#fff;border:1px solid var(--border2);border-radius:var(--radius-sm);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;position:relative}
.cloth-emoji{font-size:32px;margin-bottom:4px}
.cloth-name{font-size:9px;color:#888;text-align:center;padding:0 4px}
.cloth-badge{position:absolute;top:5px;right:5px;background:var(--purple);border-radius:50%;width:18px;height:18px;font-size:9px;color:#fff;display:flex;align-items:center;justify-content:center}
.add-cloth-item{border:1.5px dashed var(--border);border-radius:var(--radius-sm);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;color:#888;font-size:11px}
.add-cloth-plus{font-size:22px;color:var(--purple-light)}
.ai-result{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-top:16px;display:none;animation:fadeUp .4s both}
.ai-result.visible{display:block}
.ai-result-header{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.spark-badge{width:28px;height:28px;background:var(--purple);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 2px 10px var(--purple-glow)}
.ai-mood{font-size:11px;color:var(--purple-light);background:rgba(124,58,237,0.12);border-radius:20px;padding:4px 10px;display:inline-block;margin-bottom:12px}
.outfit-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px}
.outfit-tag{background:#f5f5f5;border:1px solid var(--border);border-radius:20px;padding:6px 13px;font-size:12px;color:#0A0A0A}
.ai-advice{font-size:12px;color:#888;line-height:1.6;border-top:1px solid var(--border2);padding-top:12px}
.ai-loading{display:none;align-items:center;gap:10px;padding:16px;color:#888;font-size:13px}
.ai-loading.visible{display:flex}
.ai-spinner{width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--purple);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* AVATAR */
.avatar-stage{background:#fff;border:1px solid var(--border2);border-radius:var(--radius);padding:20px 16px;display:flex;flex-direction:column;align-items:center;margin-bottom:20px;position:relative;overflow:hidden}
.avatar-stage::before{content:'';position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(0deg,rgba(124,58,237,0.08),transparent)}
.avatar-caption{font-size:12px;color:#888;margin-top:10px;position:relative;z-index:1}
.avatar-photo-btns{display:flex;gap:10px;margin-top:14px;width:100%;position:relative;z-index:1}
.avatar-photo-btns label{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;border-radius:var(--radius-sm);font-size:13px;cursor:pointer;font-weight:500}
.avatar-photo-btns label.primary{background:var(--purple);color:#fff}
.avatar-photo-btns label.secondary{background:#f5f5f5;border:1px solid var(--border);color:#0A0A0A}
.customizer{display:flex;flex-direction:column;gap:14px}
.custom-section{background:#fff;border:1px solid var(--border2);border-radius:var(--radius-sm);padding:14px}
.custom-section-title{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.8px;margin-bottom:12px}
.color-palette{display:flex;gap:8px;flex-wrap:wrap}
.color-swatch{
  width:32px;height:32px;border-radius:50%;cursor:pointer;
  border:2px solid transparent;transition:transform .2s,border .2s;
  box-shadow:0 2px 6px rgba(0,0,0,0.15);
}
.color-swatch.selected{border:3px solid #0A0A0A !important;transform:scale(1.2)}
.avatar-option-row{display:flex;gap:8px}
.avatar-option{flex:1;background:#f5f5f5;border:1px solid var(--border2);border-radius:var(--radius-sm);padding:10px 8px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
.avatar-option.selected{border-color:#a855f7;background:rgba(124,58,237,0.12)}
.avatar-option-icon{font-size:22px;display:block;margin-bottom:4px}
.avatar-option-label{font-size:10px;color:#888}
.avatar-option.selected .avatar-option-label{color:var(--purple-light)}

/* ABONNEMENTS */
.sub-cards{display:flex;flex-direction:column;gap:12px}
.sub-card{background:#fff;border:1px solid var(--border2);border-radius:var(--radius);padding:20px;position:relative;overflow:hidden}
.sub-card.featured{border-color:#a855f7;background:linear-gradient(135deg,var(--card),rgba(124,58,237,0.12))}
.sub-card.featured::after{content:'POPULAIRE';position:absolute;top:16px;right:-22px;background:var(--gold);color:#1a0533;font-size:9px;font-weight:700;letter-spacing:1px;padding:4px 30px;transform:rotate(45deg)}
.sub-plan-name{font-size:12px;font-weight:500;color:#888;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px}
.sub-card.featured .sub-plan-name{color:var(--purple-light)}
.sub-price-row{display:flex;align-items:baseline;gap:4px;margin-bottom:14px}
.sub-amount{font-family:Playfair Display,serif;font-size:34px;color:#0A0A0A;font-weight:700}
.sub-period{font-size:13px;color:#888}
.sub-features{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:18px}
.sub-feature{display:flex;align-items:center;gap:10px;font-size:13px;color:#333}
.sub-check{width:18px;height:18px;border-radius:50%;background:rgba(124,58,237,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--purple-light);font-size:10px;font-weight:700}
.sub-cta{width:100%;padding:13px;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);color:#333;font-size:14px;font-weight:500;font-family:Outfit,sans-serif;cursor:pointer}
.sub-card.featured .sub-cta{background:var(--purple);border-color:transparent;color:#fff;box-shadow:0 4px 16px var(--purple-glow)}

/* PARAMÈTRES */
.settings-group{margin-bottom:20px}
.settings-group-title{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px;padding-left:4px}
.setting-row{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:#fff;border:1px solid var(--border2);border-radius:var(--radius-sm);margin-bottom:4px;cursor:pointer}
.setting-left{display:flex;align-items:center;gap:12px}
.setting-icon{width:32px;height:32px;border-radius:9px;background:rgba(124,58,237,0.15);display:flex;align-items:center;justify-content:center;font-size:15px}
.setting-label{font-size:14px;color:#0A0A0A}
.setting-meta{font-size:12px;color:#888;margin-top:1px}
.setting-value{font-size:13px;color:#888}
.setting-arrow{font-size:14px;color:#888}
.toggle-switch{width:42px;height:24px;background:#f5f5f5;border-radius:12px;position:relative;border:1px solid var(--border);transition:background .2s;cursor:pointer}
.toggle-switch.on{background:var(--purple);border-color:transparent}
.toggle-switch::after{content:'';position:absolute;width:18px;height:18px;border-radius:50%;background:#fff;top:2px;left:2px;transition:left .2s;box-shadow:0 1px 4px rgba(0,0,0,0.3)}
.toggle-switch.on::after{left:20px}
.api-key-row{background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 16px;margin-bottom:4px}
.api-key-label{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.api-key-input-wrap{display:flex;gap:8px}
.api-key-input{flex:1;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 12px;color:#0A0A0A;font-size:13px;font-family:Outfit,sans-serif;outline:none}
.api-key-input:focus{border-color:#a855f7}
.api-save-btn{padding:10px 14px;background:var(--purple);color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;white-space:nowrap}
.logout-btn{width:100%;padding:14px;background:transparent;border:1px solid rgba(239,68,68,0.3);border-radius:var(--radius-sm);color:#f87171;font-size:14px;font-family:Outfit,sans-serif;cursor:pointer;margin-top:8px}

/* TOAST */
.toast{position:fixed;bottom:calc(env(safe-area-inset-bottom,0px) + 90px);left:50%;transform:translateX(-50%) translateY(20px);background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);padding:11px 20px;font-size:13px;color:#0A0A0A;white-space:nowrap;opacity:0;transition:opacity .3s,transform .3s;z-index:999;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,0.4)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ── CATÉGORIES ── */
.cat-tab{
  flex-shrink:0;padding:7px 14px;
  background:#fff;border:1px solid var(--border2);
  border-radius:20px;color:#888;font-size:12px;
  font-family:Outfit,sans-serif;cursor:pointer;
  white-space:nowrap;transition:all .2s;
}
.cat-tab.active{background:var(--purple);border-color:transparent;color:#fff}
.cat-sel-btn{
  padding:7px 12px;background:#fff;border:1px solid var(--border2);
  border-radius:20px;color:#888;font-size:12px;
  font-family:Outfit,sans-serif;cursor:pointer;transition:all .2s;
}
.cat-sel-btn.active{background:var(--purple);border-color:transparent;color:#fff}
.cloth-subcat{font-size:9px;color:var(--purple-light);margin-top:2px}
.clothes-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;
}
.cloth-item{
  background:#fff;border:1px solid rgba(0,0,0,0.05);
  border-radius:14px;padding:10px 6px;
  display:flex;flex-direction:column;align-items:center;
  cursor:pointer;transition:border-color .2s,transform .15s;position:relative;
}
.cloth-item:active{transform:scale(0.97);border-color:#a855f7}
.cloth-emoji{font-size:28px;margin-bottom:4px}
.cloth-name{font-size:10px;color:#333;text-align:center;line-height:1.3}
.cloth-item img{width:100%;height:70px;object-fit:cover;border-radius:6px;margin-bottom:4px}
.cloth-del{
  position:absolute;top:4px;right:4px;
  width:20px;height:20px;border-radius:50%;
  background:rgba(239,68,68,0.2);
  border:1px solid rgba(239,68,68,0.3);
  color:#f87171;font-size:11px;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  opacity:0;transition:opacity .2s;
  font-family:Outfit,sans-serif;
}
.cloth-item:hover .cloth-del,
.cloth-item:focus-within .cloth-del,
.cloth-item:active .cloth-del{opacity:1}
/* Sur mobile - toujours visible */
@media (hover: none) {
  .cloth-del{opacity:0.7}
}
/* Résultat outfit tag */
.outfit-item-tag{
  display:flex;align-items:center;gap:8px;
  background:#f5f5f5;border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:7px 10px;
}
.outfit-item-color{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.outfit-item-text{font-size:12px;color:#0A0A0A}
.outfit-item-cat{font-size:10px;color:#888;margin-left:auto}

/* ── DARK / LIGHT MODE ── */
body.dark-mode {
  --bg:#0A0A0A;--bg2:#111;--bg3:#1a1a1a;
  --card:#1a1a1a;--card2:#222;
  --text:#ffffff;--text2:#ccc;--text3:#888;
  --border:rgba(255,255,255,0.08);--border2:rgba(255,255,255,0.04);
}
body.dark-mode .tab-panel{background:#0A0A0A}
body.dark-mode .app-header{background:#111;border-bottom-color:rgba(255,255,255,0.06)}
body.dark-mode .bottom-nav{background:#111;border-top-color:rgba(255,255,255,0.06)}
body.dark-mode .cloth-item{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.dark-mode .setting-row{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.dark-mode .setting-row:hover{background:#222}
body.dark-mode .dc-input{background:#1a1a1a;border-color:rgba(255,255,255,0.1);color:#fff}
body.dark-mode .feed-post{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.dark-mode .sub-card{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.dark-mode .auth-form{background:#111}
body.dark-mode .dc-btn-outline{background:#1a1a1a;border-color:rgba(255,255,255,0.1);color:#ccc}
body.dark-mode .dash-card{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.dark-mode .ai-result{background:#1a1a1a;border-color:rgba(255,255,255,0.06)}
body.light-mode {
  --bg:#f5f5f5;--bg2:#ffffff;--bg3:#f0f0f0;
  --card:#ffffff;--card2:#f8f8f8;
  --text:#0A0A0A;--text2:#333;--text3:#888;
  --border:rgba(0,0,0,0.07);--border2:rgba(0,0,0,0.04);
}
body.light-mode .splash-bg .splash-orb,.light-mode .auth-orb{opacity:.4}
body.light-mode .app-header{background:linear-gradient(180deg,var(--bg2),var(--bg))}
body.light-mode .dc-input{background:#fff}
body.light-mode .bottom-nav{background:var(--bg2)}

/* ── MODAL MODES DE TENUE ── */
.outfit-modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.6);
  z-index:200;display:flex;align-items:flex-end;justify-content:center;
  opacity:0;pointer-events:none;transition:opacity .3s;
}
.outfit-modal-overlay.open{opacity:1;pointer-events:all}
.outfit-modal-sheet{
  background:var(--bg2);border-radius:24px 24px 0 0;
  padding:20px 20px 36px;width:100%;max-width:480px;
  border:1px solid var(--border);border-bottom:none;
  transform:translateY(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);
}
.outfit-modal-overlay.open .outfit-modal-sheet{transform:translateY(0)}
.modal-handle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 20px}
.modal-title{font-family:Playfair Display,serif;font-size:20px;color:#0A0A0A;margin-bottom:6px;text-align:center}
.modal-sub{font-size:13px;color:#888;text-align:center;margin-bottom:20px}
.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mode-card{
  background:#fff;border:1px solid var(--border2);border-radius:var(--radius);
  padding:16px 12px;display:flex;flex-direction:column;align-items:center;gap:8px;
  cursor:pointer;transition:border-color .2s,background .2s;text-align:center;
}
.mode-card:active{transform:scale(0.97)}
.mode-card.selected{border-color:#a855f7;background:rgba(124,58,237,0.08)}
.mode-icon{font-size:28px}
.mode-name{font-size:13px;font-weight:500;color:#0A0A0A}
.mode-desc{font-size:11px;color:#888;line-height:1.4}

/* ── LANGUE ── */
.lang-modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.6);
  z-index:200;display:flex;align-items:center;justify-content:center;
  opacity:0;pointer-events:none;transition:opacity .3s;padding:24px;
}
.lang-modal-overlay.open{opacity:1;pointer-events:all}
.lang-sheet{
  background:var(--bg2);border-radius:var(--radius-lg);
  padding:24px;width:100%;max-width:320px;
  border:1px solid var(--border);
}
.lang-option{
  display:flex;align-items:center;gap:12px;padding:14px;
  border-radius:var(--radius-sm);cursor:pointer;transition:background .2s;
}
.lang-option:hover{background:#f5f5f5}
.lang-option.active{background:rgba(124,58,237,0.1);border:1px solid var(--border)}
.lang-flag{font-size:24px}
.lang-name{font-size:15px;color:#0A0A0A;font-weight:400}
.lang-check{margin-left:auto;color:var(--purple);font-weight:700;display:none}
.lang-option.active .lang-check{display:block}

/* ══ FEED SOCIAL ══ */
.feed-post{
  background:#fff;border:1px solid rgba(0,0,0,0.05);
  border-radius:var(--radius);margin-bottom:12px;overflow:hidden;
}
.feed-post-header{
  display:flex;align-items:center;gap:10px;padding:12px 14px;
}
.feed-avatar{
  width:34px;height:34px;border-radius:50%;
  background:linear-gradient(135deg,#a855f7,#ec4899);
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:600;color:#fff;flex-shrink:0;
}
.feed-avatar img{width:36px;height:36px;border-radius:50%;object-fit:cover}
.feed-user-info{flex:1}
.feed-username{font-size:13px;font-weight:600;color:#0A0A0A}
.feed-date{font-size:11px;color:#888}
.feed-winner-badge{
  background:linear-gradient(135deg,#F59E0B,#F97316);
  color:#fff;font-size:9px;font-weight:700;
  padding:3px 8px;border-radius:20px;letter-spacing:.5px;
}
.feed-outfit-card{
  margin:0 14px 12px;
  background:#f5f5f5;border-radius:var(--radius-sm);
  padding:14px;border:1px solid var(--border2);
}
.feed-outfit-mood{
  font-size:11px;color:var(--purple-light);
  background:rgba(249,115,22,0.1);
  border-radius:20px;padding:4px 10px;
  display:inline-block;margin-bottom:10px;
}
.feed-outfit-items{display:flex;flex-direction:column;gap:5px}
.feed-outfit-item{
  display:flex;align-items:center;gap:8px;
  font-size:12px;color:#333;
}
.feed-item-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.feed-actions{
  display:flex;align-items:center;gap:0;
  border-top:1px solid var(--border2);
}
.feed-action-btn{
  flex:1;display:flex;align-items:center;justify-content:center;gap:6px;
  padding:11px;background:none;border:none;
  color:#888;font-size:13px;cursor:pointer;
  font-family:Outfit,sans-serif;transition:color .2s,background .2s;
}
.feed-action-btn:hover{background:#f5f5f5}
.feed-action-btn.liked{color:var(--gold)}
.feed-action-btn.liked svg{fill:var(--gold);stroke:var(--gold)}
.feed-action-divider{width:1px;background:var(--border2);height:20px;flex-shrink:0}
.feed-comments-section{
  padding:0 14px 14px;display:none;
}
.feed-comments-section.open{display:block}
.feed-comment{
  display:flex;gap:8px;margin-bottom:10px;
}
.feed-comment-avatar{
  width:26px;height:26px;border-radius:50%;
  background:#f5f5f5;display:flex;align-items:center;
  justify-content:center;font-size:11px;font-weight:600;
  color:#333;flex-shrink:0;
}
.feed-comment-bubble{
  background:#f5f5f5;border-radius:12px;padding:8px 12px;flex:1;
}
.feed-comment-name{font-size:11px;font-weight:600;color:var(--purple-light);margin-bottom:2px}
.feed-comment-text{font-size:12px;color:#333;line-height:1.4}
.feed-comment-input-wrap{
  display:flex;gap:8px;margin-top:10px;
}
.feed-comment-input{
  flex:1;background:#f5f5f5;border:1px solid var(--border);
  border-radius:20px;padding:9px 14px;color:#0A0A0A;
  font-size:13px;font-family:Outfit,sans-serif;outline:none;
}
.feed-comment-send{
  width:36px;height:36px;border-radius:50%;background:var(--purple);
  border:none;color:#fff;cursor:pointer;font-size:16px;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}

/* Tenue du mois */
.month-winner-card{
  background:linear-gradient(135deg,#2D1B69 0%,#6D28D9 40%,#a855f7 70%,#c084fc 100%);
  border-radius:var(--radius);padding:16px;margin-bottom:16px;
  position:relative;overflow:hidden;
}
.month-winner-card::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:120px;height:120px;border-radius:50%;
  background:rgba(255,255,255,0.08);
}
.share-btn{
  width:100%;padding:13px;
  background:linear-gradient(135deg,var(--purple-dark),var(--purple));
  border:none;border-radius:var(--radius-sm);
  color:#fff;font-size:14px;font-weight:500;
  font-family:Outfit,sans-serif;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  margin-bottom:16px;box-shadow:0 4px 16px var(--purple-glow);
}

/* ══ PAYWALL SCREEN ══ */
#paywallScreen{
  position:fixed;inset:0;z-index:500;
  background:var(--bg);
  display:flex;flex-direction:column;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.paywall-header{
  background:linear-gradient(135deg,#C2410C,#F97316,#F43F5E);
  padding:40px 24px 30px;
  text-align:center;position:relative;overflow:hidden;
  flex-shrink:0;
}
.paywall-header::before{
  content:'';position:absolute;
  width:300px;height:300px;border-radius:50%;
  background:rgba(255,255,255,0.06);
  top:-100px;right:-80px;
}
.paywall-logo{
  width:64px;height:64px;border-radius:20px;
  overflow:hidden;margin:0 auto 14px;
  box-shadow:0 8px 24px rgba(0,0,0,0.3);
}
.paywall-logo img{width:100%;height:100%;object-fit:cover}
.paywall-title{
  font-family:Playfair Display,serif;
  font-size:28px;font-weight:700;color:#fff;margin-bottom:6px;
}
.paywall-subtitle{font-size:14px;color:rgba(255,255,255,0.8);line-height:1.5}
.paywall-body{padding:20px 16px 40px;flex:1}
.paywall-features{
  display:flex;flex-direction:column;gap:10px;margin-bottom:20px;
}
.paywall-feature{
  display:flex;align-items:center;gap:12px;
  background:#fff;border:1px solid var(--border2);
  border-radius:var(--radius-sm);padding:12px 14px;
}
.paywall-feature-icon{font-size:22px;flex-shrink:0}
.paywall-feature-text{font-size:13px;color:#333;line-height:1.4}
.paywall-feature-text strong{color:#0A0A0A;display:block;margin-bottom:2px}
.paywall-plans{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
.paywall-plan{
  border-radius:var(--radius);padding:16px;
  border:1.5px solid var(--border2);
  cursor:pointer;transition:border-color .2s,background .2s;
  position:relative;overflow:hidden;
}
.paywall-plan.selected{
  border-color:#a855f7;
  background:rgba(249,115,22,0.08);
}
.paywall-plan.featured{
  border-color:#a855f7;
  background:linear-gradient(135deg,rgba(194,65,12,0.15),rgba(249,115,22,0.1));
}
.paywall-plan-badge{
  position:absolute;top:12px;right:12px;
  background:var(--purple);color:#fff;
  font-size:9px;font-weight:700;
  padding:3px 8px;border-radius:20px;letter-spacing:.5px;
}
.paywall-plan-name{font-size:15px;font-weight:600;color:#0A0A0A;margin-bottom:2px}
.paywall-plan-price{font-size:22px;font-weight:700;color:var(--purple)}
.paywall-plan-price span{font-size:13px;font-weight:400;color:#888}
.paywall-plan-features{font-size:12px;color:#888;margin-top:6px}
.paywall-cta{
  width:100%;padding:16px;
  background:linear-gradient(135deg,#C2410C,#F97316);
  border:none;border-radius:var(--radius-sm);
  color:#fff;font-size:16px;font-weight:600;
  font-family:Outfit,sans-serif;cursor:pointer;
  box-shadow:0 4px 20px rgba(249,115,22,0.4);
  margin-bottom:12px;
}
.paywall-skip{
  width:100%;padding:12px;background:transparent;
  border:none;color:#888;font-size:13px;
  font-family:Outfit,sans-serif;cursor:pointer;
  text-decoration:underline;
}
.paywall-legal{
  text-align:center;font-size:10px;color:#888;
  margin-top:8px;line-height:1.6;
}

/* ══ ONBOARDING ABONNEMENT ══ */
#onboardingSub{
  position:fixed;inset:0;z-index:500;
  background:var(--bg);
  display:flex;flex-direction:column;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.onboard-header{
  background:#0A0A0A;
  padding:50px 24px 36px;text-align:center;position:relative;overflow:hidden;
}
.onboard-header::before{
  content:'';position:absolute;top:-40px;right:-40px;
  width:180px;height:180px;border-radius:50%;
  background:rgba(255,255,255,0.08);
}
.onboard-header::after{
  content:'';position:absolute;bottom:-30px;left:-30px;
  width:130px;height:130px;border-radius:50%;
  background:rgba(255,255,255,0.06);
}
.onboard-logo{
  width:64px;height:64px;border-radius:18px;
  margin:0 auto 16px;overflow:hidden;
  background:#fff;display:flex;align-items:center;justify-content:center;
  position:relative;z-index:1;
}
.onboard-title{
  font-family:Playfair Display,serif;
  font-size:26px;font-weight:700;color:#fff;
  margin-bottom:6px;position:relative;z-index:1;
}
.onboard-sub{
  font-size:13px;color:rgba(255,255,255,0.8);
  position:relative;z-index:1;line-height:1.5;
}
.onboard-body{padding:20px 16px 32px}
.onboard-plan{
  background:#fff;border:1px solid rgba(0,0,0,0.07);
  border-radius:var(--radius);padding:16px;margin-bottom:10px;
  cursor:pointer;transition:border-color .2s;position:relative;overflow:hidden;
}
.onboard-plan.featured{border-color:#a855f7;border-width:1.5px}
.onboard-plan-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.onboard-plan-name{font-size:15px;font-weight:600;color:#0A0A0A}
.onboard-plan-price{font-family:Playfair Display,serif;font-size:22px;font-weight:700;color:var(--purple)}
.onboard-plan-period{font-size:11px;color:#888}
.onboard-features{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.onboard-feature{display:flex;align-items:center;gap:8px;font-size:12px;color:#333}
.onboard-feature-check{
  width:16px;height:16px;border-radius:50%;
  background:rgba(249,115,22,0.15);
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:var(--purple);font-weight:700;flex-shrink:0;
}
.onboard-cta{
  width:100%;padding:13px;
  background:var(--purple);border:none;
  border-radius:var(--radius-sm);color:#fff;
  font-size:14px;font-weight:500;
  font-family:Outfit,sans-serif;cursor:pointer;
  box-shadow:0 4px 16px var(--purple-glow);
  transition:transform .15s;
}
.onboard-cta:active{transform:scale(0.98)}
.onboard-cta.outline{
  background:transparent;color:#888;
  border:1px solid var(--border);box-shadow:none;
  font-size:13px;margin-top:8px;
}
.onboard-popular{
  position:absolute;top:0;right:0;
  background:linear-gradient(135deg,#F97316,#F43F5E);
  color:#fff;font-size:9px;font-weight:700;
  padding:5px 14px;letter-spacing:.5px;
  border-radius:0 var(--radius) 0 var(--radius-sm);
}

/* ══ DOCUMENTS LÉGAUX ══ */
.legal-h1{
  font-family:Playfair Display,serif;
  font-size:22px;font-weight:700;color:var(--purple);
  margin:24px 0 8px;padding-bottom:8px;
  border-bottom:2px solid var(--purple);
}
.legal-h2{
  font-size:15px;font-weight:600;color:#0A0A0A;
  margin:20px 0 8px;
}
.legal-p{
  font-size:13px;color:#333;line-height:1.7;
  margin-bottom:10px;
}
.legal-ul{
  padding-left:20px;margin-bottom:10px;
}
.legal-ul li{
  font-size:13px;color:#333;line-height:1.6;
  margin-bottom:4px;
}
.legal-highlight{
  background:rgba(249,115,22,0.08);
  border-left:3px solid var(--purple);
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
  padding:12px 14px;margin:12px 0;
  font-size:13px;color:#333;line-height:1.6;
}
.legal-contact{
  background:#f5f5f5;border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:14px;margin:12px 0;
  font-size:13px;color:#333;line-height:1.8;
}

/* ══ TABLEAU DE BORD CRÉATEUR ══ */
#dashboardScreen{
  position:fixed;inset:0;z-index:700;
  background:var(--bg);flex-direction:column;overflow:hidden;display:none;
}
.dash-header{
  background:#0A0A0A;
  padding:calc(env(safe-area-inset-top,0px) + 14px) 16px 16px;
  flex-shrink:0;
}
.dash-header-top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.dash-back{
  width:34px;height:34px;border-radius:50%;
  background:rgba(255,255,255,0.2);border:none;
  color:#fff;font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.dash-title{font-family:Playfair Display,serif;font-size:20px;color:#fff;font-weight:700}
.dash-sub{font-size:11px;color:rgba(255,255,255,0.75)}
.dash-stats-row{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.dash-stat{
  background:rgba(255,255,255,0.15);border-radius:var(--radius-sm);
  padding:12px;backdrop-filter:blur(10px);
}
.dash-stat-num{font-family:Playfair Display,serif;font-size:28px;font-weight:700;color:#fff}
.dash-stat-label{font-size:11px;color:rgba(255,255,255,0.75);margin-top:2px}
.dash-stat-delta{font-size:10px;color:rgba(255,255,255,0.6);margin-top:2px}
.dash-body{flex:1;overflow-y:auto;padding:16px;-webkit-overflow-scrolling:touch}
.dash-section-title{
  font-size:12px;color:#888;
  text-transform:uppercase;letter-spacing:.8px;
  margin:16px 0 10px;
}
.dash-card{
  background:#fff;border:1px solid rgba(0,0,0,0.06);
  border-radius:var(--radius);padding:16px;margin-bottom:10px;
}
.dash-card-title{font-size:14px;font-weight:600;color:#0A0A0A;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.dash-metric-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 0;border-bottom:1px solid var(--border2);
}
.dash-metric-row:last-child{border-bottom:none;padding-bottom:0}
.dash-metric-label{font-size:13px;color:#333}
.dash-metric-val{font-size:14px;font-weight:600;color:#0A0A0A}
.dash-metric-badge{
  font-size:10px;padding:3px 8px;border-radius:20px;
  background:rgba(249,115,22,0.12);color:var(--purple-light);font-weight:500;
}
.dash-bar-wrap{margin-top:8px}
.dash-bar-label{display:flex;justify-content:space-between;font-size:11px;color:#888;margin-bottom:4px}
.dash-bar-track{height:6px;background:#f5f5f5;border-radius:3px;overflow:hidden}
.dash-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#F97316,#F43F5E);transition:width 1s ease}
.dash-user-row{
  display:flex;align-items:center;gap:10px;
  padding:10px 0;border-bottom:1px solid var(--border2);
}
.dash-user-row:last-child{border-bottom:none;padding-bottom:0}
.dash-user-avatar{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,var(--purple-dark),var(--purple));
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:600;color:#fff;flex-shrink:0;
}
.dash-user-info{flex:1}
.dash-user-name{font-size:13px;font-weight:500;color:#0A0A0A}
.dash-user-email{font-size:11px;color:#888}
.dash-user-badge{
  font-size:10px;padding:2px 8px;border-radius:20px;
  background:rgba(249,115,22,0.12);color:var(--purple-light);
}
.dash-refresh{
  width:100%;padding:12px;
  background:#f5f5f5;border:1px solid var(--border);
  border-radius:var(--radius-sm);color:#333;
  font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;
  margin-top:8px;display:flex;align-items:center;justify-content:center;gap:8px;
}
.dash-spinner{
  width:14px;height:14px;border:2px solid var(--border);
  border-top-color:var(--purple);border-radius:50%;
  animation:spin .7s linear infinite;display:none;
}

/* ══ AVATAR CUSTOMIZER ══ */
.av-tab{
  flex-shrink:0;padding:7px 14px;
  background:#fff;border:1px solid rgba(0,0,0,0.08);
  border-radius:20px;color:#888;font-size:12px;font-weight:500;
  font-family:Outfit,sans-serif;cursor:pointer;white-space:nowrap;
  transition:all .2s;
}
.av-tab.active{background:#0A0A0A;color:#fff;border-color:transparent}
.av-panel{display:none;background:#fff;border:1px solid rgba(0,0,0,0.06);border-radius:16px;padding:14px;margin-bottom:12px}
.av-panel.active{display:block}
.av-option-title{font-size:11px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.av-color-row{display:flex;gap:8px;flex-wrap:wrap}
.av-swatch{
  width:30px;height:30px;border-radius:50%;cursor:pointer;
  border:2px solid transparent;transition:transform .15s,border-color .15s;
}
.av-swatch:active{transform:scale(0.9)}
.av-swatch.selected{border-color:#0A0A0A;transform:scale(1.15)}
.av-style-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.av-style-card{
  background:#f5f5f5;border:1.5px solid transparent;
  border-radius:12px;padding:10px 6px;text-align:center;
  cursor:pointer;transition:all .2s;
}
.av-style-card div:last-child{font-size:10px;color:#888;margin-top:4px;font-family:Outfit,sans-serif}
.av-style-card.selected{border-color:#6D28D9;background:rgba(109,40,217,0.06)}
.av-style-card:active{transform:scale(0.95)}
</style>
</head>
<body>
<div id="app">

<!-- SPLASH -->
<div class="screen active" id="splash" style="background:#0A0A0A;">
  <div class="splash-orb orb1"></div>
  <div class="splash-orb orb2"></div>
  <div class="splash-content">
    <div style="animation:logoIn 1s cubic-bezier(.34,1.56,.64,1) both;margin-bottom:24px">
      <div style="width:90px;height:90px;background:#fff;border-radius:24px;display:flex;align-items:center;justify-content:center;margin:0 auto;box-shadow:0 0 0 1px rgba(255,255,255,0.1)">
        <svg width="52" height="52" viewBox="0 0 40 40" fill="none">
          <path d="M20 12 C20 12 20 8 20 7 A4 4 0 0 1 28 7" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <path d="M20 12 L6 30 Q5 32 7.5 33 Q10 34 11.5 31 L20 22 L28.5 31 Q30 34 32.5 33 Q35 32 34 30 Z" fill="#0A0A0A"/>
          <circle cx="30" cy="12" r="6" fill="url(#splashGrad)"/>
          <defs><linearGradient id="splashGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#a855f7"/><stop offset="100%" stop-color="#ec4899"/></linearGradient></defs>
        </svg>
      </div></div>
    <div style="color:rgba(255,255,255,0.4);font-size:11px;letter-spacing:3px;text-transform:uppercase;font-family:Outfit,sans-serif;font-weight:300;animation:fadeUp .8s .5s both;margin-top:16px">Style · IA · Communauté</div></div>
    <div class="splash-loader"><div class="splash-loader-bar" id="loaderBar"></div></div>
  </div>
</div>

<!-- AUTH -->
<div class="screen" id="auth">
  <div class="auth-orb auth-orb1"></div>
  <div class="auth-orb auth-orb2"></div>
  <div class="auth-inner">
    <div class="auth-top">
      <div class="auth-logo-small" style="width:40px;height:40px;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;position:relative;z-index:1">
        <svg width="22" height="22" viewBox="0 0 40 40" fill="none">
          <path d="M20 10 C20 10 20 7 20 6 A3.5 3.5 0 0 1 27 6" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <path d="M20 10 L6 28 Q5 30 7.5 31 Q10 32 11.5 29 L20 20 L28.5 29 Q30 32 32.5 31 Q35 30 34 28 Z" fill="#0A0A0A"/>
          <circle cx="29" cy="12" r="5" fill="url(#authGrad)"/>
          <defs><linearGradient id="authGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#a855f7"/><stop offset="100%" stop-color="#ec4899"/></linearGradient></defs>
        </svg>
      </div>
      <div class="auth-title" id="authTitle">Créer<br/>mon compte</div>
      <div class="auth-subtitle" id="authSubtitle">Rejoignez DressCode gratuitement</div>
    </div>
    <div class="auth-form">
      <div class="auth-error" id="authError"></div>
      <div class="input-group" id="nameGroup">
        <label class="input-label">Prénom</label>
        <input class="dc-input" id="nameInput" type="text" placeholder="Votre prénom" autocomplete="given-name"/>
      </div>
      <div class="input-group">
        <label class="input-label">Email</label>
        <input class="dc-input" id="emailInput" type="email" placeholder="votre@email.com" autocomplete="email"/>
      </div>
      <div class="input-group">
        <label class="input-label">Mot de passe</label>
        <div class="pw-wrap">
          <input class="dc-input" id="passwordInput" type="password" placeholder="••••••••" autocomplete="current-password"/>
          <button class="eye-btn" id="eyeBtn" type="button" onclick="togglePw()">👁️</button>
        </div>
      </div>
      <div class="remember-row">
        <div class="remember-label" onclick="toggleRemember()">
          <div class="checkbox" id="rememberBox"></div>
          <span class="remember-text">Se souvenir de moi</span>
        </div>
        <button class="forgot-btn" type="button" onclick="showToast('Bientôt disponible')">Mot de passe oublié ?</button>
      </div>
      <button class="dc-btn" id="authBtn" onclick="handleAuth()">Créer mon compte</button>
      <div class="auth-divider"><span>ou</span></div>
      <button class="dc-btn-outline" id="faceIdBtn" onclick="handleFaceId()">
        <span>🔐</span><span id="biometricLabel">Connexion Face ID / Empreinte</span>
      </button>
      <button class="dc-btn-outline" onclick="toggleAuthMode()">
        <span id="authToggleLabel">J'ai déjà un compte – Me connecter</span>
      </button>
      <div class="auth-switch-text">En continuant vous acceptez les <button onclick="openCGU()">CGU</button> et notre <button onclick="openPrivacy()">Politique de confidentialité</button></div>
    </div>
  </div>
</div>

<!-- MAIN APP -->
<div class="screen" id="main">
  <div class="app-header">
    <div class="app-header-left">
      <div class="header-logo">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none">
          <path d="M20 10 C20 10 20 7 20 6 A3.5 3.5 0 0 1 27 6" stroke="white" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <path d="M20 10 L6 28 Q5 30 7.5 31 Q10 32 11.5 29 L20 20 L28.5 29 Q30 32 32.5 31 Q35 30 34 28 Z" fill="white"/>
        </svg>
      </div>
      <div>
        <div style="font-family:Playfair Display,serif;font-size:17px;color:#0A0A0A;font-weight:700;line-height:1">DressCode</div>
        <div id="currentTabTitle" style="font-size:11px;color:#888">Mon dressing</div>
      </div>
    </div>
    <div class="user-avatar" id="userBadge">?</div>
  </div>

  <div class="tab-area">
    <!-- DRESSING -->
    <div class="tab-panel active" id="panelDressing">

      <!-- BOUTON GÉNÉRER -->
      <div class="ai-card">
        <h3 data-i18n="gen_title">✦ Générer une tenue</h3>
        <p data-i18n="gen_sub">L'IA compose votre tenue et habille votre avatar</p>
        <button class="ai-btn" onclick="openOutfitModal()"><span>✦</span> <span data-i18n="gen_btn">Créer ma tenue</span></button>
      </div>



      <div class="ai-loading" id="aiLoading"><div class="ai-spinner"></div>L'IA compose votre tenue…</div>

      <!-- RÉSULTAT : avatar + liste -->
      <div class="ai-result" id="aiResult">
        <div class="ai-result-header"><div class="spark-badge">✦</div><h4 style="font-size:15px;color:#0A0A0A;font-weight:500">Tenue du jour</h4></div>
        <div class="ai-mood" id="aiMood">Smart casual</div>
        <div style="display:flex;gap:14px;align-items:flex-start;margin-top:12px">
          <!-- Avatar habillé -->
          <div style="flex-shrink:0">
            <svg id="outfitAvatarSvg" width="110" height="170" viewBox="0 0 140 220">
              <ellipse cx="70" cy="180" rx="35" ry="8" fill="rgba(124,58,237,0.1)"/>
              <rect id="oaPantsL" x="45" y="148" width="22" height="60" rx="8" fill="#185FA5"/>
              <rect id="oaPantsR" x="73" y="148" width="22" height="60" rx="8" fill="#185FA5"/>
              <rect id="oaShoeL" x="43" y="200" width="24" height="12" rx="5" fill="#2C2C2A"/>
              <rect id="oaShoeR" x="73" y="200" width="24" height="12" rx="5" fill="#2C2C2A"/>
              <rect id="oaArmL" x="22" y="88" width="16" height="52" rx="8" fill="#7c3aed"/>
              <rect id="oaArmR" x="102" y="88" width="16" height="52" rx="8" fill="#7c3aed"/>
              <rect id="oaShirt" x="38" y="82" width="64" height="72" rx="12" fill="#7c3aed"/>
              <rect id="oaNeck" x="62" y="75" width="16" height="16" rx="4" fill="#FAEEDA"/>
              <ellipse id="oaHead" cx="70" cy="55" rx="30" ry="34" fill="#FAEEDA"/>
              <path id="oaHat" d="" fill="none"/>
              <path id="oaHair" d="M40 42 Q40 18 70 16 Q100 18 100 42 Q100 30 70 28 Q40 30 40 42Z" fill="#5a3310"/>
              <circle cx="60" cy="52" r="4" fill="white"/><circle cx="80" cy="52" r="4" fill="white"/>
              <circle cx="61" cy="53" r="2" fill="#2C2C2A"/><circle cx="81" cy="53" r="2" fill="#2C2C2A"/>
              <path d="M63 67 Q70 73 77 67" stroke="#c47" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              <!-- Accessoires -->
              <circle id="oaNecklace" cx="70" cy="80" r="0" fill="none"/>
              <rect id="oaBag" x="0" y="0" width="0" height="0" fill="none"/>
            </svg>
          </div>
          <!-- Liste vêtements -->
          <div style="flex:1">
            <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Pièces sélectionnées</div>
            <div id="outfitTagsList" style="display:flex;flex-direction:column;gap:6px"></div>
            <div id="aiAdvice" style="font-size:12px;color:#888;line-height:1.6;border-top:1px solid var(--border2);padding-top:10px;margin-top:10px"></div>
          </div>
        </div>
      </div>

      <!-- CATÉGORIES -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;margin-top:4px">
        <h3 style="font-size:14px;font-weight:700;color:#0A0A0A;letter-spacing:-0.2px" data-i18n="wardrobe_title">Ma garde-robe</h3>
        <div style="display:flex;gap:6px">
          <button onclick="showAddClothModal()" style="display:flex;align-items:center;gap:5px;padding:7px 12px;background:linear-gradient(135deg,#4C1D95,#7C3AED,#a855f7);color:#fff;border:none;border-radius:20px;font-size:12px;cursor:pointer;font-weight:600">+ Ajouter</button>
        </div>
      </div>

      <!-- ONGLETS CATÉGORIES -->
      <div style="display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:12px;scrollbar-width:none">
        <button class="cat-tab active" onclick="filterCat(this,'all')" data-i18n="cat_all">Tout</button>
        <button class="cat-tab" onclick="filterCat(this,'tete')" data-i18n="cat_tete">🧢 Tête</button>
        <button class="cat-tab" onclick="filterCat(this,'haut')" data-i18n="cat_haut">👕 Haut</button>
        <button class="cat-tab" onclick="filterCat(this,'bas')" data-i18n="cat_bas">👖 Bas</button>
        <button class="cat-tab" onclick="filterCat(this,'chaussures')" data-i18n="cat_shoes">👟 Chaussures</button>
        <button class="cat-tab" onclick="filterCat(this,'accessoires')" data-i18n="cat_acc">💍 Accessoires</button>
        <button class="cat-tab" onclick="filterCat(this,'sac')" data-i18n="cat_bag">👜 Sac</button>
      </div>

      <div class="clothes-grid" id="clothesGrid">
        <div class="cloth-item" data-cat="haut" data-subcat="t-shirt" data-color="#fff" data-name="Chemise blanche"><div class="cloth-emoji">👔</div><div class="cloth-name">Chemise blanche</div><div class="cloth-subcat">Haut · T-shirt</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button></div>
        <div class="cloth-item" data-cat="bas" data-subcat="pantalon" data-color="#185FA5" data-name="Jean slim bleu"><div class="cloth-emoji">👖</div><div class="cloth-name">Jean slim bleu</div><div class="cloth-subcat">Bas · Pantalon</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button></div>
        <div class="cloth-item" data-cat="chaussures" data-subcat="baskets" data-color="#f0f0f0" data-name="Sneakers blanches"><div class="cloth-emoji">👟</div><div class="cloth-name">Sneakers blanches</div><div class="cloth-subcat">Chaussures · Baskets</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button></div>
        <div class="cloth-item" data-cat="haut" data-subcat="pull" data-color="#1a2a4a" data-name="Blazer marine"><div class="cloth-emoji">🧥</div><div class="cloth-name">Blazer marine</div><div class="cloth-subcat">Haut · Pull</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button></div>
        <div class="cloth-item" data-cat="haut" data-subcat="t-shirt" data-color="#e8a0b0" data-name="Robe fleurie"><div class="cloth-emoji">👗</div><div class="cloth-name">Robe fleurie</div><div class="cloth-subcat">Haut · Robe</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button></div>
      </div>

      <!-- MODAL AJOUT VÊTEMENT -->
      <div id="addClothModal" onclick="if(event.target===this)closeAddClothModal()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;align-items:flex-end;justify-content:center">
        <div style="background:var(--bg2);border-radius:24px 24px 0 0;padding:24px;width:100%;max-width:480px;border:1px solid var(--border)">
          <div style="font-family:Playfair Display,serif;font-size:18px;color:#0A0A0A;margin-bottom:16px">Ajouter un vêtement</div>

          <div style="margin-bottom:12px">
            <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Catégorie</div>
            <div style="display:flex;gap:6px;flex-wrap:wrap" id="catSelector">
              <button class="cat-sel-btn active" data-cat="haut" onclick="selectCat(this)">👕 Haut</button>
              <button class="cat-sel-btn" data-cat="tete" onclick="selectCat(this)">🧢 Tête</button>
              <button class="cat-sel-btn" data-cat="bas" onclick="selectCat(this)">👖 Bas</button>
              <button class="cat-sel-btn" data-cat="chaussures" onclick="selectCat(this)">👟 Chaussures</button>
              <button class="cat-sel-btn" data-cat="accessoires" onclick="selectCat(this)">💍 Accessoires</button>
              <button class="cat-sel-btn" data-cat="sac" onclick="selectCat(this)">👜 Sac</button>
            </div>
          </div>

          <div style="margin-bottom:12px">
            <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Sous-catégorie</div>
            <select id="subcatSelect" style="width:100%;padding:11px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:14px;font-family:Outfit,sans-serif">
              <option value="t-shirt">T-shirt</option>
              <option value="pull">Pull / Sweat</option>
              <option value="chemise">Chemise</option>
              <option value="veste">Veste / Blazer</option>
              <option value="robe">Robe</option>
            </select>
          </div>

          <div style="margin-bottom:12px">
            <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Nom du vêtement</div>
            <input id="clothNameInput" class="dc-input" placeholder="Ex: Jean slim bleu..." style="width:100%"/>
          </div>

          <div style="margin-bottom:16px">
            <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Couleur principale</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <div class="color-swatch selected" style="background:#fff;border:2px solid #ddd !important" data-color="#fff" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#1a1a1a" data-color="#1a1a1a" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#374151" data-color="#374151" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#185FA5" data-color="#185FA5" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#6D28D9" data-color="#6D28D9" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#EC4899" data-color="#EC4899" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#E24B4A" data-color="#E24B4A" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#F97316" data-color="#F97316" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#1D9E75" data-color="#1D9E75" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#f4c542" data-color="#f4c542" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#A0522D" data-color="#A0522D" onclick="selectClothColor(this)"></div>
              <div class="color-swatch" style="background:#f0a0c0" data-color="#f0a0c0" onclick="selectClothColor(this)"></div>
            </div>
          </div>

          <div style="display:flex;gap:8px;margin-bottom:12px">
            <label for="clothCamInput" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;background:var(--purple);color:#fff;border-radius:var(--radius-sm);font-size:13px;cursor:pointer">📷 Photo</label>
            <label for="clothGalInput" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;background:#f5f5f5;border:1px solid var(--border);color:#0A0A0A;border-radius:var(--radius-sm);font-size:13px;cursor:pointer">🖼️ Galerie</label>
            <input type="file" id="clothCamInput" accept="image/*" capture="environment" style="display:none" onchange="previewClothPhoto(event)"/>
            <input type="file" id="clothGalInput" accept="image/*" style="display:none" onchange="previewClothPhoto(event)"/>
          </div>
          <div id="clothPhotoPreview" style="display:none;text-align:center;margin-bottom:12px">
            <img id="clothPhotoImg" style="width:80px;height:80px;border-radius:12px;object-fit:cover;border:2px solid var(--purple)"/>
          </div>

          <div style="display:flex;gap:8px">
            <button onclick="closeAddClothModal()" style="flex:1;padding:13px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:14px;cursor:pointer">Annuler</button>
            <button onclick="confirmAddCloth()" style="flex:1;padding:13px;background:var(--purple);border:none;border-radius:var(--radius-sm);color:#fff;font-size:14px;font-weight:500;cursor:pointer">Ajouter ✓</button>
          </div>
        </div>
      </div>
      <input type="file" id="clothInput" accept="image/*" capture="environment" style="display:none;position:absolute;left:-9999px" onchange="addCloth(event)"/>
    </div>

    <!-- AVATAR -->
    <div class="tab-panel" id="panelAvatar">
      <div class="section-title">Mon Avatar</div>
      <div class="section-sub">Personnalisez votre double virtuel</div>

      <!-- AVATAR SVG PRINCIPAL -->
      <div style="background:#fff;border:1px solid rgba(0,0,0,0.06);border-radius:20px;padding:20px;margin-bottom:14px;text-align:center;position:relative">
        <div style="position:relative;display:inline-block">
          <svg id="mainAvatar" width="160" height="280" viewBox="0 0 160 280" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="faceGrad" cx="50%" cy="40%" r="60%">
      <stop id="skinTop" offset="0%" stop-color="#FDDCB5"/>
      <stop id="skinBot" offset="100%" stop-color="#F0C27F"/>
    </radialGradient>
    <radialGradient id="shirtGrad" cx="50%" cy="30%" r="70%">
      <stop id="shirtLight" offset="0%" stop-color="#8B5CF6"/>
      <stop id="shirtDark" offset="100%" stop-color="#5B21B6"/>
    </radialGradient>
    <linearGradient id="pantsGrad" x1="0" y1="0" x2="0" y2="1">
      <stop id="pantsTop" offset="0%" stop-color="#1e3a5f"/>
      <stop id="pantsBot" offset="100%" stop-color="#0f1f35"/>
    </linearGradient>
  </defs>

  <!-- Ombre sol -->
  <ellipse cx="80" cy="272" rx="38" ry="6" fill="rgba(0,0,0,0.1)"/>

  <!-- CHAUSSURES -->
  <rect id="av-shoe-l2" x="44" y="254" width="30" height="12" rx="6" fill="#222"/>
  <rect id="av-shoe-r2" x="86" y="254" width="30" height="12" rx="6" fill="#222"/>
  <ellipse id="av-shoe-l" cx="59" cy="254" rx="16" ry="5" fill="#333"/>
  <ellipse id="av-shoe-r" cx="101" cy="254" rx="16" ry="5" fill="#333"/>

  <!-- JAMBES -->
  <rect id="av-leg-l" x="48" y="178" width="28" height="80" rx="14" fill="url(#pantsGrad)"/>
  <rect id="av-leg-r" x="84" y="178" width="28" height="80" rx="14" fill="url(#pantsGrad)"/>
  <!-- Couture -->
  <line x1="62" y1="185" x2="62" y2="250" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  <line x1="98" y1="185" x2="98" y2="250" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>

  <!-- BRAS GAUCHE (simple rect arrondi) -->
  <rect id="av-arm-l" x="20" y="110" width="26" height="70" rx="13" fill="#8B5CF6"/>
  <!-- MAIN GAUCHE -->
  <ellipse id="av-hand-l" cx="33" cy="184" rx="11" ry="13" fill="#FDDCB5"/>
  <!-- Doigts gauche -->
  <rect x="24" y="190" width="7" height="10" rx="3.5" fill="#F5C49A"/>
