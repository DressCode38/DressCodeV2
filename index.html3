var currentOutfitMode = 'quotidien';
var modeLabels = {
  fr: {quotidien:'Tenue du jour',soiree:'Soirée',chill:'Chill',sport:'Sport',travail:'Travail',date:'Rendez-vous'},
  en: {quotidien:'Daily outfit',soiree:'Evening',chill:'Chill',sport:'Sport',travail:'Work',date:'Date night'},
  es: {quotidien:'Outfit del día',soiree:'Noche',chill:'Chill',sport:'Deporte',travail:'Trabajo',date:'Cita'}
};
var modePrompts = {
  quotidien:'une tenue décontractée et pratique pour une journée normale',
  soiree:'une tenue élégante et stylée pour une soirée ou une sortie',
  chill:'une tenue ultra-confortable et détendue pour rester à la maison',
  sport:'une tenue fonctionnelle et confortable pour faire du sport',
  travail:'une tenue professionnelle et soignée pour aller au travail',
  date:'une tenue séduisante et originale pour un rendez-vous romantique'
};

function openOutfitModal() {
  var modal = document.getElementById('outfitModeModal');
  if (modal) modal.classList.add('open');
}
function closeOutfitModal(e) {
  if (!e || e.target.id === 'outfitModeModal') {
    document.getElementById('outfitModeModal').classList.remove('open');
  }
}
function selectMode(mode) {
  currentOutfitMode = mode;
  document.querySelectorAll('.mode-card').forEach(function(c){ c.classList.remove('selected'); });
  event.currentTarget.classList.add('selected');
  document.getElementById('outfitModeModal').classList.remove('open');
  setTimeout(function(){ generateOutfit(); }, 300);
}

/* ══════════════════════════════════════
   DARK / LIGHT MODE
══════════════════════════════════════ */
var isDark = localStorage.getItem('dc_theme') === 'dark';

function applyTheme() {
  if (isDark) {
    document.body.classList.add('dark-mode');
    document.body.classList.remove('light-mode');
    var tog = document.getElementById('darkToggle');
    if (tog) tog.classList.add('on');
  } else {
    document.body.classList.remove('dark-mode');
    document.body.classList.add('light-mode');
    var tog = document.getElementById('darkToggle');
    if (tog) tog.classList.remove('on');
  }
}
function toggleTheme() {
  isDark = !isDark;
  localStorage.setItem('dc_theme', isDark ? 'dark' : 'light');
  applyTheme();
  showToast(isDark ? '🌙 Mode sombre activé' : '☀️ Mode clair activé');
}
// Appliquer au chargement
window.addEventListener('load', function(){
  document.body.classList.add('light-mode');
  applyTheme();
  applyLang();
  applyNotifState();
  // Pré-remplir email si sauvegardé
  var savedEmail = localStorage.getItem('dc_saved_email');
  var emailInput = document.getElementById('emailInput');
  if (savedEmail && emailInput) emailInput.value = savedEmail;
  if (savedEmail && localStorage.getItem('dc_saved_pw')) {
    rememberMe = true;
    var box = document.getElementById('rememberCheckbox');
    if (box) {
      box.style.background = 'var(--purple)';
      box.style.borderColor = 'var(--purple)';
      box.innerHTML = '<span style="color:#fff;font-size:12px;font-weight:700">✓</span>';
    }
  }
});

