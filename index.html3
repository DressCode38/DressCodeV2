  <line x1="90" y1="105" x2="80" y2="122" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>

  <!-- COU -->
  <rect id="av-neck" x="68" y="88" width="24" height="22" rx="10" fill="#FDDCB5"/>
  <!-- Ombre cou -->
  <rect x="68" y="100" width="24" height="10" rx="0" fill="rgba(0,0,0,0.05)"/>

  <!-- TETE -->
  <ellipse id="av-head" cx="80" cy="56" rx="40" ry="46" fill="url(#faceGrad)"/>

  <!-- OREILLES -->
  <ellipse id="av-ear-l" cx="40" cy="60" rx="7" ry="9" fill="#F0C27F"/>
  <ellipse cx="40" cy="60" rx="4" ry="5" fill="#E8A87C" opacity="0.5"/>
  <ellipse id="av-ear-r" cx="120" cy="60" rx="7" ry="9" fill="#F0C27F"/>
  <ellipse cx="120" cy="60" rx="4" ry="5" fill="#E8A87C" opacity="0.5"/>

  <!-- CHEVEUX -->
  <path id="av-hair" d="M40 48 Q40 10 80 6 Q120 10 120 48 Q118 28 80 24 Q42 28 40 48Z" fill="#2C1810"/>

  <!-- SOURCILS -->
  <path id="av-brow-l" d="M55 42 Q64 38 72 41" stroke="#1a0e08" stroke-width="2.5" fill="none" stroke-linecap="round"/>
  <path id="av-brow-r" d="M88 41 Q96 38 105 42" stroke="#1a0e08" stroke-width="2.5" fill="none" stroke-linecap="round"/>

  <!-- YEUX - blancs de l oeil -->
  <ellipse cx="66" cy="56" rx="10" ry="11" fill="white"/>
  <ellipse cx="94" cy="56" rx="10" ry="11" fill="white"/>
  <!-- Iris -->
  <ellipse id="av-eye-l" cx="66" cy="57" rx="7" ry="8" fill="#2C1810"/>
  <ellipse id="av-eye-r" cx="94" cy="57" rx="7" ry="8" fill="#2C1810"/>
  <!-- Pupilles -->
  <ellipse cx="66" cy="57" rx="4" ry="4.5" fill="#0a0604"/>
  <ellipse cx="94" cy="57" rx="4" ry="4.5" fill="#0a0604"/>
  <!-- Reflets -->
  <ellipse cx="69" cy="54" rx="2.5" ry="3" fill="white" opacity="0.9"/>
  <ellipse cx="97" cy="54" rx="2.5" ry="3" fill="white" opacity="0.9"/>
  <!-- Cils superieur gauche -->
  <path d="M56 47 Q57 43 59 46" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  <path d="M63 45 Q63 41 65 44" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  <path d="M70 46 Q71 42 72 45" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  <!-- Cils superieur droit -->
  <path d="M84 46 Q85 42 86 45" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  <path d="M91 45 Q91 41 93 44" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  <path d="M98 47 Q99 43 100 46" stroke="#1a0e08" stroke-width="1.5" fill="none" stroke-linecap="round"/>

  <!-- NEZ -->
  <ellipse cx="75" cy="70" rx="3" ry="2" fill="rgba(0,0,0,0.08)"/>
  <ellipse cx="85" cy="70" rx="3" ry="2" fill="rgba(0,0,0,0.08)"/>
  <path d="M78 66 Q80 72 82 66" stroke="rgba(0,0,0,0.1)" stroke-width="1.5" fill="none" stroke-linecap="round"/>

  <!-- BOUCHE -->
