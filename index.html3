</div>
<div class="toast" id="toast"></div>

<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-storage.js"></script>
<script>
// ── FIREBASE CONFIG ──
// ── COMPTE CRÉATEUR ──
var CREATOR_EMAIL = 'lucatheron@gmail.com'; // Email créateur unique

const firebaseConfig = {
  apiKey: "AIzaSyCG8re5Ac_Ghojkzg6wYXOwY_C_SmrQvrY",
  authDomain: "dresscodev2.firebaseapp.com",
  projectId: "dresscodev2",
  storageBucket: "dresscodev2.firebasestorage.app",
  messagingSenderId: "138161783807",
  appId: "1:138161783807:web:896a229f818c5e8ba79dca"
};

let auth, db, storage, currentUser;
let ANTHROPIC_API_KEY = localStorage.getItem('dc_api_key') || '';
let isLoginMode = false;
let rememberMe = false;
let pwVisible = false;
let outfitCount = 0;

// ── INIT FIREBASE ──
function initFirebase() {
  if (typeof firebase === 'undefined') {
    console.warn('Firebase pas encore chargé, retry dans 500ms...');
    setTimeout(initFirebase, 500);
    return;
  }
  try {
    firebase.initializeApp(firebaseConfig);
    auth = firebase.auth();
    db = firebase.firestore();
    storage = firebase.storage();
    console.log('✅ Firebase initialisé avec Storage');
    auth.onAuthStateChanged(function(user) {
      if (user) {
        currentUser = user;
        var splash = document.getElementById('splash');
        if (splash && splash.classList.contains('active')) {
          setTimeout(function() { onUserLoggedIn(user); }, 1500);
        } else {
          onUserLoggedIn(user);
        }
      }
    });
  } catch(e) {
    console.warn('Firebase non disponible:', e.message);
  }
}
// Attendre que le DOM + scripts soient chargés
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initFirebase);
} else {
  initFirebase();
}

// ── SPLASH ──
var progress = 0;
var bar = document.getElementById('loaderBar');
var loaderInterval = setInterval(function() {
  progress = Math.min(progress + Math.random() * 3 + 1, 100);
  bar.style.width = progress + '%';
  if (progress >= 100) {
    clearInterval(loaderInterval);
    setTimeout(function() {
      if (!currentUser) showScreen('auth');
    }, 400);
  }
}, 60);

// ── SCREENS ──
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(function(s) { s.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
}

// ── AUTH MODE ──
function toggleAuthMode() {
  isLoginMode = !isLoginMode;
  document.getElementById('nameGroup').style.display = isLoginMode ? 'none' : '';
  document.getElementById('authTitle').innerHTML = isLoginMode ? 'Bon<br/>retour !' : 'Créer<br/>mon compte';
  document.getElementById('authSubtitle').textContent = isLoginMode ? 'Connectez-vous à DressCode' : 'Rejoignez DressCode gratuitement';
  document.getElementById('authBtn').textContent = isLoginMode ? 'Me connecter' : 'Créer mon compte';
  document.getElementById('authToggleLabel').textContent = isLoginMode ? "Pas encore de compte – S'inscrire" : "J'ai déjà un compte – Me connecter";
  clearAuthError();
}

function showAuthError(msg) {
  var el = document.getElementById('authError');
  el.textContent = msg;
  el.classList.add('visible');
}
function clearAuthError() {
  document.getElementById('authError').classList.remove('visible');
}

// ── PASSWORD TOGGLE ──
function togglePw() {
  pwVisible = !pwVisible;
  document.getElementById('passwordInput').type = pwVisible ? 'text' : 'password';
  document.getElementById('eyeBtn').textContent = pwVisible ? '🙈' : '👁️';
}

// ── REMEMBER ME ──
function toggleRemember() {
  rememberMe = !rememberMe;
  var box = document.getElementById('rememberBox');
  if (rememberMe) {
    box.classList.add('checked');
    box.innerHTML = '<span style="color:#fff;font-size:12px;font-weight:700">✓</span>';
  } else {
    box.classList.remove('checked');
    box.innerHTML = '';
  }
}

// ── FACE ID ──
async function handleFaceId() {
  var savedEmail = localStorage.getItem('dc_saved_email');
  var savedPw = localStorage.getItem('dc_saved_pw');

  if (!savedEmail || !savedPw) {
    showToast('Connectez-vous avec "Se souvenir de moi" dabord');
    return;
  }

  if (window.PublicKeyCredential) {
    try {
      var available = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
      if (available) {
        navigator.credentials.get({
          publicKey: {challenge: new Uint8Array(16), timeout: 60000, userVerification: 'required'}
        }).then(function() {
          autoSignIn(savedEmail, savedPw);
        }).catch(function(e) {
          if (e.name !== 'NotAllowedError') autoSignIn(savedEmail, savedPw);
          else showToast('Face ID annulé');
        });
        return;
      }
    } catch(e) {}
  }
  autoSignIn(savedEmail, savedPw);
}

async function autoSignIn(savedEmail, savedPw) {
  if (!auth) { showToast('Connexion en cours...'); return; }
  try {
    var btn = document.getElementById('authSubmitBtn');
    if (btn) { btn.classList.add('loading'); btn.disabled = true; }
    var password;
    try {
      var decoded = decodeURIComponent(escape(atob(savedPw)));
      password = decoded.includes(':') ? decoded.split(':').slice(1).join(':') : decoded;
    } catch(e) { password = atob(savedPw); }
    var result = await auth.signInWithEmailAndPassword(savedEmail, password);
    onUserLoggedIn(result.user);
    showToast('Connexion automatique reussie !');
  } catch(e) {
    showToast('Reconnexion echouee — connectez-vous manuellement');
    localStorage.removeItem('dc_saved_pw');
    var btn = document.getElementById('authSubmitBtn');
    if (btn) { btn.classList.remove('loading'); btn.disabled = false; }
  }
}

// Cacher Face ID si non disponible
if (window.PublicKeyCredential) {
  PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable().then(function(ok) {
    if (!ok) document.getElementById('faceIdBtn').style.display = 'none';
  });
} else {
  document.getElementById('faceIdBtn').style.display = 'none';
}

// ── HANDLE AUTH ──
async function handleAuth() {
  var email = document.getElementById('emailInput').value.trim();
  var password = document.getElementById('passwordInput').value;
  var name = document.getElementById('nameInput').value.trim();
  var btn = document.getElementById('authBtn');
  clearAuthError();
  if (!email || !password) { showAuthError('Merci de remplir tous les champs.'); return; }
  if (!isLoginMode && !name) { showAuthError('Entrez votre prénom.'); return; }
  if (password.length < 6) { showAuthError('Le mot de passe doit faire au moins 6 caractères.'); return; }
  btn.classList.add('loading');
  btn.disabled = true;
  try {
    // Toujours garder la session (LOCAL) pour eviter de se reconnecter
    await auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL);
    // Sauvegarder pour Face ID si "Se souvenir de moi" coché
    if (rememberMe) {
      localStorage.setItem('dc_saved_email', email);
      localStorage.setItem('dc_saved_pw', btoa(unescape(encodeURIComponent(password))));
    }
    if (isLoginMode) {
      var result = await auth.signInWithEmailAndPassword(email, password);
      if (rememberMe) { localStorage.setItem('dc_saved_email', email); localStorage.setItem('dc_saved_pw', btoa(password)); }
      onUserLoggedIn(result.user);
    } else {
      var cred = await auth.createUserWithEmailAndPassword(email, password);
      await cred.user.updateProfile({ displayName: name });
      if (rememberMe) { localStorage.setItem('dc_saved_email', email); localStorage.setItem('dc_saved_pw', btoa(password)); }
      try { if (db) await db.collection('users').doc(cred.user.uid).set({ name: name, email: email, createdAt: firebase.firestore.FieldValue.serverTimestamp() }); } catch(e) {}
      onUserLoggedIn(cred.user);
    }
  } catch(e) {
    var msgs = {
      'auth/email-already-in-use': 'Cet email est déjà utilisé.',
      'auth/user-not-found': 'Aucun compte avec cet email.',
      'auth/wrong-password': 'Mot de passe incorrect.',
      'auth/invalid-credential': 'Email ou mot de passe incorrect.',
      'auth/invalid-email': 'Email invalide.',
      'auth/too-many-requests': 'Trop de tentatives. Réessayez plus tard.',
      'auth/network-request-failed': 'Erreur réseau. Vérifiez votre connexion.',
    };
    showAuthError(msgs[e.code] || 'Erreur : ' + e.message);
    btn.classList.remove('loading');
    btn.disabled = false;
  }
}

function onUserLoggedIn(user) {
  setTimeout(loadAvatarConfig, 500);
  setTimeout(loadClothesFromStorage, 1000);
  setTimeout(renderAvatar, 800);
  setTimeout(function(){ checkSubscription(user); }, 800);
  setTimeout(checkMonthlyWinner, 1500);
  setTimeout(checkIfCurrentUserWon, 2000);
  // Afficher l'onboarding si c'est la première connexion
  var onboardDone = localStorage.getItem('dc_onboard_done');
  var isCreator = user.email && user.email.toLowerCase() === CREATOR_EMAIL.toLowerCase();
  if (!onboardDone && !isCreator) {
    setTimeout(showOnboarding, 800);
  }
  var isCreator = user.email && user.email.toLowerCase() === CREATOR_EMAIL.toLowerCase();
  if (isCreator) {
    applyCreatorMode();
  } else {
    applyUserMode();
  }
  currentUser = user;
  var name = user.displayName || user.email || 'U';
  document.getElementById('userBadge').textContent = name.charAt(0).toUpperCase();
  document.getElementById('userEmailDisplay').textContent = user.email || name;
  if (ANTHROPIC_API_KEY) document.getElementById('apiKeyInput').value = '••••••••';
  showScreen('main');
}

function handleLogout() {
  if (auth) auth.signOut();
  localStorage.removeItem('dc_saved_email');
  localStorage.removeItem('dc_saved_pw');
  showScreen('auth');
  showToast('A bientot !');
}

// ── TABS ──
var tabTitles = { dressing: 'Mon dressing', avatar: 'Mon avatar', sub: 'Abonnements', settings: 'Parametres' };
function switchTab(tab) {
  ['dressing','avatar','community','sub','settings','history'].forEach(function(t) {
    var panel = document.getElementById('panel' + t.charAt(0).toUpperCase() + t.slice(1));
    var nav = document.getElementById('nav' + t.charAt(0).toUpperCase() + t.slice(1));
    if (panel) panel.classList.toggle('active', t === tab);
    if (nav) nav.classList.toggle('active', t === tab);
  });
  var titles = {dressing:'Mon dressing',avatar:'Mon avatar',sub:'Abonnements',settings:'Paramètres',history:'Historique'};
  var titleEl = document.getElementById('currentTabTitle');
  if (titleEl) titleEl.textContent = titles[tab] || tab;
  if (tab === 'history') renderHistory();
  if (tab === 'community') renderCommunityFeed();
}

// ── AVATAR ──
/* ── AVATAR BITMOJI & PHOTO ── */
var avatarUrl = localStorage.getItem('dc_avatar_url') || '';

function importAvatar(e) {
  var file = e.target.files[0];
  if (!file) return;

  showToast('Chargement de l image...');

  var reader = new FileReader();
  reader.onerror = function() { showToast('Erreur lecture fichier'); };
  reader.onload = function(ev) {
    var originalSrc = ev.target.result;

    // Redimensionner via canvas
    var tempImg = new Image();
    tempImg.onerror = function() {
      // Si erreur redimensionnement, utiliser l'image originale
      avatarUrl = originalSrc;
      applyAvatarToDOM(originalSrc);
    };
    tempImg.onload = function() {
      try {
        var canvas = document.createElement('canvas');
        var MAX = 300;
        var ratio = Math.min(MAX / tempImg.width, MAX / tempImg.height, 1);
        canvas.width = Math.max(1, Math.round(tempImg.width * ratio));
        canvas.height = Math.max(1, Math.round(tempImg.height * ratio));
        var ctx = canvas.getContext('2d');
        ctx.drawImage(tempImg, 0, 0, canvas.width, canvas.height);
        var resized = canvas.toDataURL('image/jpeg', 0.8);
        avatarUrl = resized;
        applyAvatarToDOM(resized);
      } catch(canvasErr) {
        avatarUrl = originalSrc;
        applyAvatarToDOM(originalSrc);
      }
    };
    tempImg.src = originalSrc;
  };
  reader.readAsDataURL(file);
}

function applyAvatarToDOM(src) {
  // Sauvegarder
  try { localStorage.setItem('dc_avatar_url', src); } catch(e) {}

  // Trouver les éléments
  var placeholder = document.getElementById('avatarPlaceholder');
  var savedWrap = document.getElementById('avatarSavedWrap');
  var savedImg = document.getElementById('avatarSavedImg');

  console.log('applyAvatarToDOM:', placeholder ? 'placeholder OK' : 'NO placeholder',
    savedWrap ? 'wrap OK' : 'NO wrap',
    savedImg ? 'img OK' : 'NO img');

  if (!savedImg || !savedWrap) {
    showToast('Erreur affichage - rechargez l app');
    return;
  }

  // Appliquer l'image
  savedImg.setAttribute('src', src);
  savedImg.style.cssText = 'width:160px;height:160px;object-fit:cover;border-radius:50%;border:3px solid var(--purple);box-shadow:0 0 30px var(--purple-glow);margin-bottom:12px;display:block;';

  // Cacher placeholder
  if (placeholder) {
    placeholder.style.display = 'none';
    placeholder.setAttribute('hidden', '');
  }

  // Montrer le wrap
  savedWrap.style.cssText = 'display:block;visibility:visible;opacity:1;';
  savedWrap.removeAttribute('hidden');

  // Toast et scroll
  showToast('Avatar enregistre !');
  var panel = document.getElementById('panelAvatar');
  if (panel) panel.scrollTop = 0;
}

function showAvatarSaved(src) {
  applyAvatarToDOM(src);
}

function resetAvatar() {
  avatarUrl = '';
  localStorage.removeItem('dc_avatar_url');
  var placeholder = document.getElementById('avatarPlaceholder');
  var savedWrap = document.getElementById('avatarSavedWrap');
  if (placeholder) placeholder.style.display = 'block';
  if (savedWrap) savedWrap.style.display = 'none';
  showToast('Avatar supprime');
}

function loadSavedAvatar() {
  var saved = localStorage.getItem('dc_avatar_url');
  if (saved) { avatarUrl = saved; showAvatarSaved(saved); }
}

function applyAvatarPhoto(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    var img = document.getElementById('avatarPhotoImg');
    img.src = ev.target.result;
    document.getElementById('avatarPhotoPreview').style.display = 'block';
    var defs = document.getElementById('avatarDefs');
    defs.innerHTML = '<pattern id="facePattern" patternUnits="objectBoundingBox" width="1" height="1"><image href="' + ev.target.result + '" width="60" height="68" preserveAspectRatio="xMidYMid slice"/></pattern>';
    document.getElementById('avHead').setAttribute('fill', 'url(#facePattern)');
    document.getElementById('avHair').setAttribute('fill', 'none');
    showToast('Avatar mis a jour !');
  };
  reader.readAsDataURL(file);
}

function setAvatarColor(el) {
  var type = el.dataset.type;
  var val = el.dataset.val;
  el.closest('.color-palette').querySelectorAll('.color-swatch').forEach(function(s) { s.classList.remove('selected'); });
  el.classList.add('selected');
  if (type === 'skin') {
    document.getElementById('avHead').setAttribute('fill', val);
    document.getElementById('avNeck').setAttribute('fill', val);
  } else if (type === 'hair') {
    document.getElementById('avHair').setAttribute('fill', val);
  } else if (type === 'shirt') {
    document.getElementById('avShirt').setAttribute('fill', val);
    document.getElementById('avArmL').setAttribute('fill', val);
    document.getElementById('avArmR').setAttribute('fill', val);
  }
}

function selectHairStyle(el, style) {
  el.closest('.avatar-option-row').querySelectorAll('.avatar-option').forEach(function(o) { o.classList.remove('selected'); });
  el.classList.add('selected');
  var hair = document.getElementById('avHair');
  if (style === 'short') hair.setAttribute('d', 'M40 42 Q40 18 70 16 Q100 18 100 42 Q100 30 70 28 Q40 30 40 42Z');
  if (style === 'medium') hair.setAttribute('d', 'M40 42 Q38 18 70 14 Q102 18 100 42 Q100 28 70 26 Q40 28 40 42 M40 42 Q35 60 38 70 M100 42 Q105 60 102 70Z');
  if (style === 'long') hair.setAttribute('d', 'M40 42 Q36 18 70 12 Q104 18 100 42 Q100 26 70 24 Q40 26 40 42 M40 42 Q32 65 34 90 M100 42 Q108 65 106 90Z');
  showToast('Style applique !');
}

// ── DRESSING ──
function addCloth(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    var grid = document.getElementById('clothesGrid');
    var last = grid.querySelector('.add-cloth-item');
    var div = document.createElement('div');
    div.className = 'cloth-item';
    div.innerHTML = '<img src="' + ev.target.result + '" style="width:100%;height:100%;object-fit:cover"/><div class="cloth-badge">✓</div>';
    grid.insertBefore(div, last);
    showToast('Vetement ajoute !');
  };
  reader.readAsDataURL(file);
}

// ── GENERATE OUTFIT ──
/* ── CATÉGORIES ── */
const subcats = {
  tete: ['Casquette','Bonnet','Bob','Chapeau','Autre'],
  haut: ['T-shirt','Pull / Sweat','Chemise','Veste / Blazer','Robe','Autre'],
  bas: ['Pantalon','Jean','Short','Jupe','Survetement','Autre'],
  chaussures: ['Baskets','Boots','Sandales','Chaussures de ville','Autre'],
  accessoires: ['Collier',"Boucles doreilles",'Bague','Lunettes','Montre','Autre'],
  sac: ['Sac a dos','Sac a main','Sacoche','Tote bag','Autre']
};
const catEmojis = {tete:'🧢',haut:'👕',bas:'👖',chaussures:'👟',accessoires:'💍',sac:'👜'};
let selectedClothCat = 'haut';
let selectedClothColor = '#fff';
let clothPhotoData = null;

function saveClothesToStorage() {
  var clothes = [];
  document.querySelectorAll('#clothesGrid .cloth-item').forEach(function(el) {
    var imgEl = el.querySelector('img');
    var imgSrc = imgEl ? imgEl.src : null;
    // Ne sauvegarder que les URLs Firebase (http) pas les base64 (data:)
    var photoToSave = null;
    if (imgSrc && imgSrc.startsWith('http')) {
      photoToSave = imgSrc; // URL Firebase Storage
    } else if (imgSrc && imgSrc.startsWith('data:')) {
      photoToSave = imgSrc; // Fallback base64 (petit fichier seulement)
    }
    clothes.push({
      name: el.dataset.name || '',
      cat: el.dataset.cat || 'haut',
      subcat: el.dataset.subcat || '',
      color: el.dataset.color || '#888',
      photo: photoToSave,
      emoji: el.querySelector('.cloth-emoji') ? el.querySelector('.cloth-emoji').textContent : '👕'
    });
  });
  try {
    localStorage.setItem('dc_clothes', JSON.stringify(clothes));
    // Aussi sauvegarder dans Firestore si connecté
    if (db && currentUser) {
      db.collection('users').doc(currentUser.uid).collection('clothes').doc('wardrobe').set({
        items: clothes.map(function(c) { return { name:c.name, cat:c.cat, subcat:c.subcat, color:c.color, photo:c.photo, emoji:c.emoji }; }),
        updatedAt: new Date().toISOString()
      }).catch(function(e) { console.warn('Firestore save error:', e); });
    }
  } catch(e) { console.warn('save error:', e); }
}

function loadClothesFromStorage() {
  // Essayer d'abord Firestore
  if (db && currentUser) {
    db.collection('users').doc(currentUser.uid).collection('clothes').doc('wardrobe').get()
      .then(function(doc) {
        if (doc.exists && doc.data().items && doc.data().items.length > 0) {
          renderClothes(doc.data().items);
        } else {
          loadFromLocalStorage();
        }
      }).catch(function() { loadFromLocalStorage(); });
  } else {
    loadFromLocalStorage();
  }
}

function loadFromLocalStorage() {
  try {
    var saved = JSON.parse(localStorage.getItem('dc_clothes') || '[]');
    if (!saved.length) return;
    renderClothes(saved);
  } catch(e) { console.warn('load error:', e); }
}

function renderClothes(saved) {
  try {
    var grid = document.getElementById('clothesGrid');
    if (!grid) return;
    // Supprimer les vêtements existants sauf le bouton ajouter
    var existingItems = grid.querySelectorAll('.cloth-item, .add-cloth-item');
    existingItems.forEach(function(el) { el.remove(); });

    saved.forEach(function(item) {
      if (!item.name) return; // Ignorer les entrées vides
      var div = document.createElement('div');
      div.className = 'cloth-item';
      div.dataset.cat = item.cat || 'haut';
      div.dataset.subcat = item.subcat || '';
      div.dataset.color = item.color || '#888';
      div.dataset.name = item.name || '';
      div.dataset.emoji = item.emoji || '👕';

      // Photo Firebase (http) ou base64 (data:)
      if (item.photo && (item.photo.startsWith('http') || item.photo.startsWith('data:'))) {
        div.innerHTML = '<img src="' + item.photo + '" style="width:100%;height:70px;object-fit:cover;border-radius:6px;margin-bottom:4px"/>' +
          '<div class="cloth-name">' + (item.name||'') + '</div>' +
          '<div class="cloth-subcat">' + (item.subcat||item.cat||'') + '</div>' +
          '<button class="cloth-del" onclick="deleteCloth(this)">✕</button>';
      } else {
        div.innerHTML = '<div class="cloth-emoji">' + (item.emoji||'👕') + '</div>' +
          '<div class="cloth-name">' + (item.name||'') + '</div>' +
          '<div class="cloth-subcat">' + (item.subcat||item.cat||'') + '</div>' +
          '<button class="cloth-del" onclick="deleteCloth(this)">✕</button>';
      }
      grid.appendChild(div);
    });

    // Remettre le bouton ajouter à la fin
    var addBtn = document.createElement('label');
    addBtn.className = 'add-cloth-item';
    addBtn.setAttribute('for', 'clothCamInput');
    addBtn.innerHTML = '<div class="add-plus">+</div><div class="add-text">Photographier</div>';
    grid.appendChild(addBtn);

  } catch(e) { console.warn('renderClothes error:', e); }
}

function deleteCloth(btn) {
  var item = btn.closest('.cloth-item') || btn.parentElement;
  var name = item.dataset.name || 'ce vêtement';
  // Confirmation rapide
  item.style.transition = 'opacity .3s, transform .3s';
  item.style.opacity = '0';
  item.style.transform = 'scale(0.8)';
  setTimeout(function() {
    item.remove();
    saveClothesToStorage();
    showToast('Vêtement supprimé');
  }, 280);
}

function filterCat(btn, cat) {
  document.querySelectorAll('.cat-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#clothesGrid .cloth-item').forEach(item => {
    item.style.display = (cat === 'all' || item.dataset.cat === cat) ? '' : 'none';
  });
}

function showAddClothModal() {
  document.getElementById('addClothModal').style.display = 'flex';
  clothPhotoData = null;
  document.getElementById('clothPhotoPreview').style.display = 'none';
  document.getElementById('clothNameInput').value = '';
  selectedClothCat = 'haut';
  selectedClothColor = '#fff';
  updateSubcats();
}
function closeAddClothModal() {
  document.getElementById('addClothModal').style.display = 'none';
}
function selectCat(btn) {
  document.querySelectorAll('.cat-sel-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  selectedClothCat = btn.dataset.cat;
  updateSubcats();
}
function updateSubcats() {
  const sel = document.getElementById('subcatSelect');
  if (!sel) return;
  sel.innerHTML = (subcats[selectedClothCat] || []).map(s =>
    '<option value="' + s.toLowerCase() + '">' + s + '</option>'
  ).join('');
}
function selectClothColor(el) {
  // Supprimer selected de tous les swatches du modal
  document.querySelectorAll('.color-swatch').forEach(function(s) {
    s.classList.remove('selected');
    s.style.border = '2px solid transparent';
    s.style.transform = 'scale(1)';
  });
  // Appliquer selected au swatch cliqué
  el.classList.add('selected');
  el.style.border = '3px solid #0A0A0A';
  el.style.transform = 'scale(1.2)';
  selectedClothColor = el.dataset.color;
  console.log('Couleur sélectionnée:', selectedClothColor);
}
function previewClothPhoto(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => {
    clothPhotoData = ev.target.result;
    document.getElementById('clothPhotoImg').src = clothPhotoData;
    document.getElementById('clothPhotoPreview').style.display = 'block';
  };
  reader.readAsDataURL(file);
}
function confirmAddCloth() {
  const nameInput = document.getElementById('clothNameInput');
  const subcatSel = document.getElementById('subcatSelect');
  const name = (nameInput && nameInput.value.trim()) || (subcatSel ? subcatSel.value : 'Vetement');
  const subcat = subcatSel ? subcatSel.value : '';
  const grid = document.getElementById('clothesGrid');
  const emoji = catEmojis[selectedClothCat] || '👕';
  const div = document.createElement('div');
  div.className = 'cloth-item';
  div.dataset.cat = selectedClothCat;
  div.dataset.subcat = subcat;
  div.dataset.color = selectedClothColor;
  div.dataset.name = name;
  if (clothPhotoData) {
    div.innerHTML = '<img src="' + clothPhotoData + '"/><div class="cloth-name">' + name + '</div><div class="cloth-subcat">' + (catEmojis[selectedClothCat]||'') + ' ' + subcat + '</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button>';
  } else {
    div.innerHTML = '<div class="cloth-emoji">' + emoji + '</div><div class="cloth-name">' + name + '</div><div class="cloth-subcat">' + (catEmojis[selectedClothCat]||'') + ' ' + subcat + '</div><button class="cloth-del" onclick="deleteCloth(this)">✕</button>';
  }
  // Si photo, uploader dans Firebase Storage
  if (clothPhotoData && storage && currentUser) {
    uploadClothPhoto(clothPhotoData, div, grid);
  } else {
    grid.appendChild(div);
    closeAddClothModal();
    saveClothesToStorage();
    showToast(t('cloth_added') || 'Vêtement ajouté !');
  }
}

async function uploadClothPhoto(photoData, div, grid) {
  showToast('Upload en cours...');
  try {
    // Convertir base64 en blob
    var response = await fetch(photoData);
    var blob = await response.blob();
    var fileName = 'clothes/' + currentUser.uid + '/' + Date.now() + '.jpg';
    var ref = storage.ref(fileName);
    await ref.put(blob);
    var url = await ref.getDownloadURL();

    // Mettre à jour le div avec l'URL Firebase
    div.dataset.photoUrl = url;
    if (div.querySelector('img')) {
      div.querySelector('img').src = url;
    }
    grid.appendChild(div);
    closeAddClothModal();
    saveClothesToStorage();
    showToast(t('cloth_added') || 'Vêtement ajouté !');
  } catch(e) {
    console.error('Upload error:', e);
    // Fallback : utiliser la photo locale
    grid.appendChild(div);
    closeAddClothModal();
    saveClothesToStorage();
    showToast('Vêtement ajouté (photo locale)');
  }
}

/* ── HABILLER L'AVATAR RÉSULTAT ── */
const catColors = {tete:'#2C2C2A',haut:'#7c3aed',bas:'#185FA5',chaussures:'#2C2C2A',accessoires:'#f4c542',sac:'#8D5524'};
function dressOutfitAvatar(items) {
  // Reset
  document.getElementById('oaShirt').setAttribute('fill','#7c3aed');
  document.getElementById('oaArmL').setAttribute('fill','#7c3aed');
  document.getElementById('oaArmR').setAttribute('fill','#7c3aed');
  document.getElementById('oaPantsL').setAttribute('fill','#185FA5');
  document.getElementById('oaPantsR').setAttribute('fill','#185FA5');
  document.getElementById('oaShoeL').setAttribute('fill','#2C2C2A');
  document.getElementById('oaShoeR').setAttribute('fill','#2C2C2A');
  document.getElementById('oaHat').setAttribute('d','');

  items.forEach(item => {
    const color = item.color || catColors[item.cat] || '#888';
    if (item.cat === 'haut') {
      document.getElementById('oaShirt').setAttribute('fill', color);
      document.getElementById('oaArmL').setAttribute('fill', color);
      document.getElementById('oaArmR').setAttribute('fill', color);
    } else if (item.cat === 'bas') {
      document.getElementById('oaPantsL').setAttribute('fill', color);
      document.getElementById('oaPantsR').setAttribute('fill', color);
    } else if (item.cat === 'chaussures') {
      document.getElementById('oaShoeL').setAttribute('fill', color);
      document.getElementById('oaShoeR').setAttribute('fill', color);
    } else if (item.cat === 'tete') {
      document.getElementById('oaHat').setAttribute('d','M40 28 Q40 12 70 10 Q100 12 100 28 L98 35 Q70 28 42 35 Z');
      document.getElementById('oaHat').setAttribute('fill', color);
    }
  });
}

function getAllClothes() {
  var items = [];
  document.querySelectorAll('#clothesGrid .cloth-item').forEach(function(el) {
    var imgEl = el.querySelector('img');
    var photo = null;
    if (imgEl && imgEl.src && (imgEl.src.startsWith('http') || imgEl.src.startsWith('data:'))) {
      photo = imgEl.src;
    }
    items.push({
      name: el.dataset.name || (el.querySelector('.cloth-name') ? el.querySelector('.cloth-name').textContent : 'Vetement'),
      cat: el.dataset.cat || 'haut',
      subcat: el.dataset.subcat || '',
      color: el.dataset.color || '#888',
      photo: photo,
      hasPhoto: !!photo
    });
  });
  return items;
}

async function generateOutfit() {
  if (!checkOutfitLimit()) return;

  var loading = document.getElementById('aiLoading');
  var result = document.getElementById('aiResult');
  result.classList.remove('visible');
  loading.classList.add('visible');

  var clothes = getAllClothes();
  var modeDesc = modePrompts[currentOutfitMode] || modePrompts['quotidien'];

  if (!ANTHROPIC_API_KEY) {
    await new Promise(function(r) { setTimeout(r, 1500); });
    loading.classList.remove('visible');
    var moodLabel = (modeLabels[currentLang]||modeLabels['fr'])[currentOutfitMode]||'Smart casual';
    var haut = clothes.find(function(c){return c.cat==='haut';}) || {name:'Chemise blanche',cat:'haut',color:'#fff',subcat:'t-shirt'};
    var bas = clothes.find(function(c){return c.cat==='bas';}) || {name:'Jean slim bleu',cat:'bas',color:'#185FA5',subcat:'jean'};
    var shoes = clothes.find(function(c){return c.cat==='chaussures';}) || {name:'Sneakers blanches',cat:'chaussures',color:'#f0f0f0',subcat:'baskets'};
    showOutfit(moodLabel, [haut, bas, shoes], 'Ajoutez votre cle API dans les Reglages pour activer IA');
    return;
  }

  try {
    // Construire le message avec photos si disponibles
    var messageContent = [];
    var clothesWithPhotos = clothes.filter(function(c){ return c.photo && (c.photo.startsWith('http') || c.photo.startsWith('data:')); });
    var clothesWithoutPhotos = clothes.filter(function(c){ return !c.photo || (!c.photo.startsWith('http') && !c.photo.startsWith('data:')); });

    // Ajouter les photos des vêtements (Claude Vision)
    if (clothesWithPhotos.length > 0) {
      messageContent.push({
        type: 'text',
        text: 'Tu es un styliste expert. Voici les photos des vêtements du dressing de l utilisateur. Analyse chaque vêtement visible.'
      });

      // Ajouter jusqu'à 8 photos max (limite API)
      var photosToSend = clothesWithPhotos.slice(0, 8);
      for (var i = 0; i < photosToSend.length; i++) {
        var cloth = photosToSend[i];
        messageContent.push({
          type: 'text',
          text: 'Vêtement ' + (i+1) + ': ' + cloth.name + ' (' + cloth.cat + ')'
        });
        try {
          var photoData = await getPhotoAsBase64(cloth.photo);
          if (photoData) {
            messageContent.push({
              type: 'image',
              source: {
                type: 'base64',
                media_type: 'image/jpeg',
                data: photoData
              }
            });
          }
        } catch(photoErr) {
          console.warn('Photo error:', photoErr);
        }
      }
    }

    // Ajouter les vêtements sans photo en texte
    var allClothesText = clothes.map(function(c){
      return '- ' + c.name + ' (' + c.cat + (c.subcat ? ', ' + c.subcat : '') + ')';
    }).join('\n');

    // Séparer vêtements avec et sans photos
    var clothesWithPhotoNames = clothes.filter(function(c){ return c.hasPhoto; }).map(function(c){ return c.name + ' (' + c.cat + ')'; });
    var clothesNoPhotoNames = clothes.filter(function(c){ return !c.hasPhoto; }).map(function(c){ return c.name + ' (' + c.cat + ')'; });

    var promptText = 'Tu es un styliste expert. ' +
      (clothesWithPhotoNames.length > 0 ? 'Vetements AVEC PHOTOS (PRIORITE ABSOLUE pour la tenue): ' + clothesWithPhotoNames.join(', ') + '. ' : '') +
      (clothesNoPhotoNames.length > 0 ? 'Vetements sans photo (utiliser seulement si manque): ' + clothesNoPhotoNames.join(', ') + '. ' : '') +
      'Mode: ' + modeDesc + '. ' +
      'IMPORTANT: compose la tenue EN PRIORITE avec les vetements qui ont des photos. ' +
      'Reponds UNIQUEMENT en JSON valide: {"mood":"style en 2 mots","items":[{"name":"nom exact du vetement","cat":"categorie","color":"#hex","subcat":"sous-categorie","conseil_piece":"conseil court"}],"conseil":"conseil general","occasion":"quand porter","astuce_mode":"astuce pro"}';
    messageContent.push({ type: 'text', text: promptText });

    var resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-opus-4-5',
        max_tokens: 800,
        messages: [{ role: 'user', content: messageContent }]
      })
    });

    var data = await resp.json();
    if (data.error) throw new Error(data.error.message);

    var text = data.content[0].text;
    var json = JSON.parse(text.replace(/```json|```/g,'').trim());
    loading.classList.remove('visible');

    // Enrichir avec les couleurs du dressing
    var enriched = (json.items || []).map(function(item) {
      var found = clothes.find(function(c){
        return c.name.toLowerCase().includes(item.name.toLowerCase()) ||
               item.name.toLowerCase().includes(c.name.toLowerCase());
      });
      return found ? Object.assign({}, found, item) : item;
    });

    showOutfit(json.mood, enriched, json.conseil, json.occasion, json.astuce_mode);

  } catch(e) {
    console.error('generateOutfit error:', e);
    loading.classList.remove('visible');
    var haut = clothes.find(function(c){return c.cat==='haut';}) || {name:'Chemise blanche',cat:'haut',color:'#fff'};
    var bas = clothes.find(function(c){return c.cat==='bas';}) || {name:'Jean slim bleu',cat:'bas',color:'#185FA5'};
    var shoes = clothes.find(function(c){return c.cat==='chaussures';}) || {name:'Sneakers blanches',cat:'chaussures',color:'#f0f0f0'};
    showOutfit('Smart casual', [haut, bas, shoes], 'Erreur IA - verifiez votre cle API dans les Reglages');
  }
}

// Convertir une URL Firebase ou base64 en base64 pur pour l'API
async function getPhotoAsBase64(photoUrl) {
  if (!photoUrl) return null;
  if (photoUrl.startsWith('data:')) {
    // Déjà en base64 - extraire juste les données
    return photoUrl.split(',')[1];
  }
  if (photoUrl.startsWith('http')) {
    // URL Firebase Storage - fetch et convertir
    try {
      var resp = await fetch(photoUrl);
      var blob = await resp.blob();
      return new Promise(function(resolve, reject) {
        var reader = new FileReader();
        reader.onloadend = function() {
          var base64 = reader.result.split(',')[1];
          resolve(base64);
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    } catch(e) {
      console.warn('Fetch photo error:', e);
      return null;
    }
  }
  return null;
}

function showOutfit(mood, items, conseil, occasion, astuce) {
  document.getElementById('aiMood').textContent = mood;

  var tagsList = document.getElementById('outfitTagsList');
  if (tagsList) {
    // Enrichir les items avec les vraies photos du dressing
    var allClothesInWardrobe = getAllClothes();
    tagsList.innerHTML = items.map(function(item) {
      var name = typeof item === 'string' ? item : item.name;
      var cat = typeof item === 'object' ? (item.cat||'haut') : 'haut';
      var color = typeof item === 'object' ? (item.color||'#888') : '#888';
      var subcat = typeof item === 'object' ? (item.subcat||cat) : cat;
      var conseilPiece = typeof item === 'object' ? (item.conseil_piece||'') : '';
      var emoji = ({tete:'🧢',haut:'👕',bas:'👖',chaussures:'👟',accessoires:'💍',sac:'👜'})[cat]||'👕';

      // Chercher la vraie photo dans le dressing
      var wardrobeItem = allClothesInWardrobe.find(function(c) {
        return c.name && name && (
          c.name.toLowerCase().includes(name.toLowerCase()) ||
          name.toLowerCase().includes(c.name.toLowerCase())
        );
      });
      var photoUrl = wardrobeItem ? wardrobeItem.photo : null;

      return '<div class="outfit-item-tag" style="padding:10px;gap:10px">' +
        (photoUrl && (photoUrl.startsWith('http') || photoUrl.startsWith('data:')) ?
          '<img src="' + photoUrl + '" style="width:52px;height:52px;object-fit:cover;border-radius:10px;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,0.1)"/>' :
          '<div style="width:52px;height:52px;border-radius:10px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0">' + emoji + '</div>'
        ) +
        '<div style="flex:1;min-width:0">' +
          '<div class="outfit-item-text" style="font-weight:600">' + name + '</div>' +
          '<div style="font-size:10px;color:#888;margin-top:1px">' + subcat + '</div>' +
          (conseilPiece ? '<div style="font-size:10px;color:#a855f7;margin-top:3px">💡 ' + conseilPiece + '</div>' : '') +
        '</div>' +
      '</div>';
    }).join('');
  }

  // Conseil principal
  var adviceEl = document.getElementById('aiAdvice');
  if (adviceEl) {
    var adviceHtml = '';
    if (conseil) adviceHtml += '<div style="margin-bottom:6px">💡 ' + conseil + '</div>';
    if (occasion) adviceHtml += '<div style="margin-bottom:6px">📅 <strong>Occasion :</strong> ' + occasion + '</div>';
    if (astuce) adviceHtml += '<div>✨ <strong>Astuce :</strong> ' + astuce + '</div>';
    adviceEl.innerHTML = adviceHtml;
  }

  document.getElementById('aiResult').classList.add('visible');

  // Habiller l'avatar avec les couleurs
  if (typeof dressOutfitAvatar === 'function') {
    var avatarItems = items.map(function(i){ return typeof i === 'string' ? {name:i,cat:'haut',color:'#888'} : i; });
    dressOutfitAvatar(avatarItems);
  }

  // Appliquer les couleurs sur l'avatar principal aussi
  items.forEach(function(item) {
    if (typeof item !== 'object') return;
    if (item.cat === 'haut' && item.color) {
      avatarConfig.shirt = item.color;
    } else if (item.cat === 'bas' && item.color) {
      avatarConfig.pants = item.color;
    } else if (item.cat === 'chaussures' && item.color) {
      avatarConfig.shoes = item.color;
    }
  });
  renderAvatar();

  // Sauvegarder dans historique
  saveToHistory(mood, items, conseil);
  outfitCount++;
  var countEl = document.getElementById('outfitCount');
  if (countEl) countEl.textContent = outfitCount + ' tenue(s)';
}

/* ── HISTORIQUE ── */
var outfitHistory = [];
try { outfitHistory = JSON.parse(localStorage.getItem('dc_history') || '[]'); } catch(e) { outfitHistory = []; }

function saveToHistory(mood, items, conseil) {
  var entry = {
    id: Date.now(),
    date: new Date().toLocaleDateString('fr-FR', {day:'2-digit',month:'short',year:'numeric'}),
    time: new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}),
    mood: mood,
    items: items,
    conseil: conseil
  };
  outfitHistory.unshift(entry);
  if (outfitHistory.length > 50) outfitHistory.pop();
  localStorage.setItem('dc_history', JSON.stringify(outfitHistory));
}

function renderHistory() {
  var list = document.getElementById('historyList');
  var empty = document.getElementById('historyEmpty');
  var subtitle = document.getElementById('historySubtitle');
  if (!list) return;

  if (outfitHistory.length === 0) {
    list.style.display = 'none';
    if (empty) empty.style.display = 'block';
    return;
  }
  if (empty) empty.style.display = 'none';
  list.style.display = 'flex';
  var clearBtn = document.getElementById('historyClearBtn');
  if (clearBtn) clearBtn.style.display = outfitHistory.length > 0 ? 'block' : 'none';
  if (subtitle) subtitle.textContent = outfitHistory.length + ' tenue(s) générée(s)';

  list.innerHTML = outfitHistory.map(function(entry) {
    var itemsHtml = entry.items.map(function(item) {
      var name = typeof item === 'string' ? item : item.name;
      var cat = typeof item === 'object' ? (item.cat||'haut') : 'haut';
      var color = typeof item === 'object' ? (item.color||'#888') : '#888';
      var emoji = ({tete:'🧢',haut:'👕',bas:'👖',chaussures:'👟',accessoires:'💍',sac:'👜'})[cat] || '👕';
      return '<div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#333">' +
        '<div style="width:10px;height:10px;border-radius:50%;background:' + color + ';flex-shrink:0;border:1px solid rgba(255,255,255,0.2)"></div>' +
        emoji + ' ' + name + '</div>';
    }).join('');

    return '<div style="background:#fff;border:1px solid var(--border2);border-radius:var(--radius);padding:16px;position:relative">' +
      '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">' +
        '<div style="display:flex;align-items:center;gap:8px">' +
          '<div style="width:28px;height:28px;background:var(--purple);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px">✦</div>' +
          '<div>' +
            '<div style="font-size:13px;font-weight:500;color:#0A0A0A">' + entry.mood + '</div>' +
            '<div style="font-size:11px;color:#888">' + entry.date + ' à ' + entry.time + '</div>' +
          '</div>' +
        '</div>' +
        '<button onclick="deleteHistory(' + entry.id + ')" style="background:none;border:none;color:#888;font-size:16px;cursor:pointer;padding:4px">✕</button>' +
      '</div>' +
      '<div style="display:flex;flex-direction:column;gap:5px;margin-bottom:10px">' + itemsHtml + '</div>' +
      (entry.conseil ? '<div style="font-size:11px;color:#888;border-top:1px solid var(--border2);padding-top:8px;line-height:1.5">💡 ' + entry.conseil + '</div>' : '') +
    '</div>';
  }).join('');
}

function deleteHistory(id) {
  outfitHistory = outfitHistory.filter(function(e){ return e.id !== id; });
  localStorage.setItem('dc_history', JSON.stringify(outfitHistory));
  renderHistory();
  showToast('Tenue supprimée');
}

function clearAllHistory() {
  outfitHistory = [];
  localStorage.removeItem('dc_history');
  renderHistory();
  showToast('Historique effacé');
}

