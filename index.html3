        <div class="setting-row">
          <div class="setting-left"><div class="setting-icon">👤</div><div><div class="setting-label" data-i18n="my_profile">Mon profil</div><div class="setting-meta" id="userEmailDisplay">—</div></div></div>
          <div class="setting-arrow">›</div>
        </div>
        <div class="setting-row" onclick="switchTab('sub')">
          <div class="setting-left"><div class="setting-icon">💳</div><div class="setting-label" data-i18n="subscription">Abonnement</div></div>
          <div style="display:flex;align-items:center;gap:6px"><div class="setting-value">Gratuit</div><div class="setting-arrow">›</div></div>
        </div>
