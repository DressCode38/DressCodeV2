        <div class="dash-metric-val" style="color:var(--purple-light)" id="dashMonthlyRevenue">0€</div>
      </div>
      <div style="margin-top:12px;padding:10px;background:#f5f5f5;border-radius:var(--radius-sm);font-size:12px;color:#888">
        💡 Pour les chiffres exacts, consultez votre <span onclick="window.open('https://dashboard.stripe.com','_blank')" style="color:var(--purple-light);cursor:pointer;text-decoration:underline">tableau de bord Stripe</span>
      </div>
    </div>

    <!-- TOP TENUES COMMUNAUTÉ -->
    <div class="dash-section-title">✨ Top tenues du mois</div>
    <div class="dash-card">
      <div class="dash-card-title">❤️ Classement par likes</div>
      <div id="dashTopPosts">
        <div style="font-size:13px;color:#888;text-align:center;padding:20px">Chargement...</div>
      </div>
    </div>

    <!-- UTILISATEURS RÉCENTS -->
    <div class="dash-section-title">👥 Derniers utilisateurs</div>
    <div class="dash-card">
      <div class="dash-card-title">🆕 Inscrits récemment</div>
      <div id="dashRecentUsers">
        <div style="font-size:13px;color:#888;text-align:center;padding:20px">Chargement...</div>
      </div>
    </div>

    <!-- ACTIONS CRÉATEUR -->
    <div class="dash-section-title">⚙️ Actions</div>
    <div class="dash-card">
      <div class="dash-card-title">🛠️ Gestion</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <button onclick="window.open('https://dashboard.stripe.com','_blank')" style="display:flex;align-items:center;gap:10px;padding:12px;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;text-align:left">
          <span style="font-size:18px">💳</span> Tableau de bord Stripe
        </button>
        <button onclick="window.open('https://console.firebase.google.com/project/dresscodev2','_blank')" style="display:flex;align-items:center;gap:10px;padding:12px;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;text-align:left">
          <span style="font-size:18px">🔥</span> Console Firebase
        </button>
        <button onclick="window.open('https://vercel.com','_blank')" style="display:flex;align-items:center;gap:10px;padding:12px;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;text-align:left">
          <span style="font-size:18px">▲</span> Tableau de bord Vercel
        </button>
        <button onclick="window.open('https://dress-code-landing.vercel.app','_blank')" style="display:flex;align-items:center;gap:10px;padding:12px;background:#f5f5f5;border:1px solid var(--border);border-radius:var(--radius-sm);color:#0A0A0A;font-size:13px;cursor:pointer;font-family:Outfit,sans-serif;text-align:left">
          <span style="font-size:18px">🌐</span> Landing page publique
        </button>
      </div>
    </div>

    <button class="dash-refresh" onclick="loadDashboard()">
      <div class="dash-spinner" id="dashSpinner"></div>
      <span id="dashRefreshText">🔄 Actualiser les données</span>
    </button>
    <div style="height:32px"></div>
  </div>
</div>
</body>
</html>
