  <ellipse id="av-hand-r" cx="127" cy="184" rx="11" ry="13" fill="#FDDCB5"/>
  <!-- Doigts droit -->
  <rect x="113" y="190" width="6" height="10" rx="3" fill="#F5C49A"/>
  <rect x="121" y="192" width="7" height="10" rx="3.5" fill="#F5C49A"/>
  <rect x="129" y="190" width="7" height="10" rx="3.5" fill="#F5C49A"/>

  <!-- CORPS / HAUT -->
