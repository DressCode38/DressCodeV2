          <div class="setting-left"><div class="setting-icon">✦</div><div><div class="setting-label" data-i18n="outfits_generated">Tenues générées</div><div class="setting-meta" id="outfitCount">0 tenue(s)</div></div></div>
          <div class="setting-arrow">›</div>
