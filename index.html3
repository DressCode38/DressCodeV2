            <div style="font-size:15px;font-weight:600;color:#fff" id="monthWinnerName">En attente de votes...</div>
          </div>
        </div>
        <div style="font-size:12px;color:rgba(255,255,255,0.8)" id="monthWinnerInfo">La tenue avec le plus de likes gagne un mois Premium offert !</div>
        <div style="margin-top:10px;background:rgba(0,0,0,0.2);border-radius:20px;height:6px;overflow:hidden">
          <div id="monthProgress" style="height:100%;background:#fff;border-radius:20px;width:0%;transition:width 1s"></div>
        </div>
        <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:6px" id="monthCountdown">Vote jusqu'au 1er du mois</div>
      </div>

      <!-- PARTAGER MA TENUE -->
      <button class="share-btn" onclick="shareLastOutfit()" id="shareOutfitBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        Partager ma dernière tenue
      </button>

      <!-- FEED -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div style="font-size:15px;font-weight:600;color:#0A0A0A">Tenues de la communauté</div>
        <div style="font-size:12px;color:#888" id="feedCount">0 tenue(s)</div>
      </div>
      <div id="communityFeed">
        <div style="text-align:center;padding:40px 20px" id="feedEmpty">
          <div style="font-size:48px;margin-bottom:12px">👗</div>
          <div style="font-size:14px;color:#333;margin-bottom:6px">Aucune tenue partagée</div>
          <div style="font-size:12px;color:#888">Soyez le premier à partager votre tenue du jour !</div>
        </div>
      </div>
    </div>

    <!-- HISTORIQUE -->
    <div class="tab-panel" id="panelHistory">
      <div class="section-title">Historique</div>
      <div class="section-sub" id="historySubtitle" data-i18n="history_sub">Vos tenues générées</div>
      <div id="historyEmpty" style="text-align:center;padding:40px 20px;display:none">
        <div style="font-size:48px;margin-bottom:16px">✦</div>
        <div style="font-size:15px;color:#0A0A0A;margin-bottom:8px">Aucune tenue générée</div>
        <div style="font-size:13px;color:#888;margin-bottom:20px">Allez dans le dressing et générez votre première tenue !</div>
        <button onclick="switchTab('dressing')" style="padding:12px 28px;background:linear-gradient(135deg,#4C1D95,#7C3AED,#a855f7);color:#fff;border:none;border-radius:50px;font-size:14px;cursor:pointer;font-weight:600">Aller au dressing</button>
      </div>
      <div id="historyList" style="display:flex;flex-direction:column;gap:12px"></div>
      <div id="historyClearBtn" style="margin-top:12px;display:none">
        <button onclick="clearAllHistory()" style="width:100%;padding:12px;background:transparent;border:1px solid rgba(239,68,68,0.3);border-radius:var(--radius-sm);color:#f87171;font-size:13px;cursor:pointer;font-family:Outfit,sans-serif">Effacer tout l'historique</button>
      </div>
    </div>

        <div class="tab-panel" id="panelSettings">
      <div id="creatorBadge" style="display:none;align-items:center;gap:12px;background:linear-gradient(135deg,#7e22ce,#a855f7,#ec4899);border-radius:var(--radius);padding:14px 16px;margin-bottom:16px;align-items:center;gap:12px">
        <div style="font-size:24px">👑</div>
        <div>
          <div style="font-size:14px;font-weight:600;color:#fff">Compte Créateur</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.8)">Accès Premium illimité</div>
        </div>
